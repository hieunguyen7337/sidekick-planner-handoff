#!/bin/bash
#PBS -N u1-g2
#PBS -q cpu_inter
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=01:30:00
#PBS -j oe
#PBS -o /mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs/U1_g2_appworld.out

set -euo pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HOME=/scratch/n12194778/hf
export SIDEKICK_SCRATCH=/scratch/n12194778/sidekick
export SIDEKICK_VENV=/scratch/n12194778/sidekick/env
export APPWORLD_ROOT=/scratch/n12194778/sidekick/appworld
export PATH="${SIDEKICK_VENV}/bin:${HOME}/.local/bin:${PATH}"
REPO=/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15
cd "${REPO}"
echo "[pbs] host=$(hostname) job=${PBS_JOBID} start=$(date -Iseconds)"
"${SIDEKICK_VENV}/bin/python" "${REPO}/scripts/setup/g2_appworld_gate.py"
echo "[pbs] g2 exit=$? at $(date -Iseconds)"

#!/bin/bash
#PBS -N hj4b-fixed-k-dev
#PBS -q gpu_inter
#PBS -l select=1:ncpus=16:ngpus=1:mem=128gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs/hj4b_fixed_k_dev.out
#
# HJ-4b held-out dev evaluation: serve granite-4.2-8b with the sft_b LoRA and
# run fixed_k (k=5) against the cached dev teacher packets. The final stage
# adds train seed 3 to the existing HJ-4 correction campaign using its frozen
# train config. The --lora-modules alias MUST equal executor.lora_name.
#
# Job variables (override at qsub time):
#   ADAPTER_SFT_B, ALIAS_SFT_B
# Do NOT add reasoning-parser flags (G3); they parked generations in
# reasoning_content and looked like parse_error.

set -uo pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HOME=/scratch/n12194778/hf
export APPWORLD_ROOT=/scratch/n12194778/sidekick/appworld
export SIDEKICK_VENV=/scratch/n12194778/sidekick/env
export PATH="${SIDEKICK_VENV}/bin:${HOME}/.local/bin:${PATH}"
export PYTHONPATH="/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/src:${PYTHONPATH:-}"
# CODEX_HOME is deliberately NOT set: the default ~/.codex holds auth.json and the
# per-thread session transcripts. Repointing it at an empty dir strands credentials.
CU13="${SIDEKICK_VENV}/lib/python3.12/site-packages/nvidia/cu13"
if [[ -x "${CU13}/bin/nvcc" ]]; then
  export CUDA_HOME="${CU13}"; export CUDA_PATH="${CU13}"
  export PATH="${CU13}/bin:${PATH}"
  export LD_LIBRARY_PATH="${CU13}/lib:${CU13}/lib64:${LD_LIBRARY_PATH:-}"
fi
export VLLM_USE_FLASHINFER_SAMPLER=0
export FLASHINFER_CACHE_DIR=/scratch/n12194778/sidekick/logs/flashinfer_cache_u9
ulimit -n 65536 2>/dev/null || ulimit -n 16384 2>/dev/null || ulimit -n 8192 2>/dev/null || true
echo "[u9] ulimit -n soft=$(ulimit -Sn) hard=$(ulimit -Hn)"
export TORCHINDUCTOR_CACHE_DIR=/scratch/n12194778/sidekick/cache/inductor
export TRITON_CACHE_DIR=/scratch/n12194778/sidekick/cache/triton
mkdir -p "${TORCHINDUCTOR_CACHE_DIR}" "${TRITON_CACHE_DIR}" "${FLASHINFER_CACHE_DIR}"

REPO=/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15
export SIDEKICK_START_COMMIT="$(git -C "${REPO}" rev-parse HEAD 2>/dev/null || echo unknown)"
OUT=/scratch/n12194778/sidekick/results
LOGDIR=/scratch/n12194778/sidekick/logs
PY="${SIDEKICK_VENV}/bin/python"
SUM="${REPO}/scripts/setup/campaign_summarize.py"
MODEL=ibm-granite/granite-4.2-8b
VLOG="${LOGDIR}/hj4b_fixed_k_dev_vllm.log"

# ---- LoRA aliases: MUST equal executor.lora_name in both campaign configs ----
ALIAS_SFT_B="${ALIAS_SFT_B:-sft_b}"
ADAPTER_SFT_B="${ADAPTER_SFT_B:-/scratch/n12194778/sidekick/artifacts/adapters/sft_b_s123_granite8b}"

cd "${REPO}" || exit 1
mkdir -p "${LOGDIR}" "${OUT}/results" /scratch/n12194778/sidekick/codex_scratch

CFG_DEV="${REPO}/configs/hj4b_fixed_k_dev.yaml"
CFG_TRAIN="${REPO}/configs/hj4_correction.yaml"
RUN_DATE="$(date +%Y%m%d)"
DEV_CID="hj4b_fixed_k_dev_${RUN_DATE}"
SMOKE_CID="${DEV_CID}_smoke"
TRAIN_CID=hj4_correction_train_20260917

if [[ ! -f "${CFG_DEV}" || ! -f "${CFG_TRAIN}" ]]; then
  echo "[hj4b] FATAL: campaign config absent"
  exit 2
fi

LORA_MODULES=()
register_lora () {
  local alias="$1"
  local path="$2"
  if [[ -z "${path}" ]]; then
    return 0
  fi
  if [[ ! -d "${path}" ]]; then
    echo "[hj4b] FATAL: adapter path for alias ${alias} is not a directory: ${path}" >&2
    exit 2
  fi
  LORA_MODULES+=("${alias}=${path}")
  echo "[hj4b] lora-module ${alias}=${path}"
}
register_lora "${ALIAS_SFT_B}" "${ADAPTER_SFT_B}"
if [[ "${#LORA_MODULES[@]}" -eq 0 ]]; then
  echo "[hj4b] FATAL: no LoRA modules registered; set ADAPTER_SFT_B" >&2
  exit 2
fi

VLLM_PID=""

kill_vllm () {
  if [[ -n "${VLLM_PID}" ]] && kill -0 "${VLLM_PID}" 2>/dev/null; then
    kill "${VLLM_PID}" 2>/dev/null || true
    for _ in $(seq 1 12); do kill -0 "${VLLM_PID}" 2>/dev/null || break; sleep 5; done
    kill -9 "${VLLM_PID}" 2>/dev/null || true
    wait "${VLLM_PID}" 2>/dev/null || true
  fi
  pkill -f "vllm serve" 2>/dev/null || true
  pkill -f "EngineCore" 2>/dev/null || true
  sleep 5
  echo "[hj4b] GPU after shutdown:"
  nvidia-smi --query-gpu=memory.used,utilization.gpu --format=csv,noheader || true
}

archive_campaign () {
  local cid="$1"
  local archive_basename="${2:-${cid}}"
  local runs="${OUT}/results/${cid}/runs.jsonl"
  local manifest="${OUT}/results/${cid}/manifest.json"
  if [[ ! -f "${runs}" || ! -f "${manifest}" ]]; then
    echo "[hj4b] FATAL: cannot archive ${cid}: runs or manifest missing" >&2
    return 1
  fi
  timeout 300 cp "${runs}" "${REPO}/campaign/results/${archive_basename}.runs.jsonl" || return $?
  timeout 300 cp "${manifest}" "${REPO}/campaign/results/${archive_basename}.manifest.json" || return $?
  echo "[hj4b] archived ${cid} as ${archive_basename} runs + manifest"
}

count_episodes () {
  local seed_root="$1"
  if [[ ! -d "${seed_root}" ]]; then
    echo 0
    return 0
  fi
  timeout 120 find "${seed_root}" -mindepth 2 -maxdepth 2 -type f -name result.json -print | wc -l
}

summarise_campaign () {
  local cid="$1"
  local cfg="$2"
  timeout 300 "${PY}" "${SUM}" \
    --out "${OUT}" --campaign-id "${cid}" \
    --config "${cfg}" --repo "${REPO}" \
    --manifest "${OUT}/results/${cid}/manifest.json" \
    --gate --expect-planner --expect-model gpt-5.6-luna
}

# ---- preflight: the planner must be reachable BEFORE a GPU is held ------------
echo "[hj4b] ---- preflight ----"
if ! command -v codex >/dev/null 2>&1; then
  echo "[hj4b] FATAL: codex not on PATH"; exit 1
fi
if [[ ! -s "${HOME}/.codex/auth.json" ]]; then
  echo "[hj4b] FATAL: ~/.codex/auth.json missing or empty -- planner cannot authenticate"
  exit 1
fi
echo "[hj4b] codex $(codex --version 2>/dev/null || echo '?')"
echo "[hj4b] auth.json present (contents never printed)"

# ---- vLLM: LoRA registered statically at launch ------------------------------
kill_vllm
"${SIDEKICK_VENV}/bin/vllm" serve "${MODEL}" \
  --served-model-name "${MODEL}" \
  --dtype bfloat16 \
  --max-model-len 32768 \
  --host 127.0.0.1 --port 8000 \
  --gpu-memory-utilization 0.85 \
  --enable-lora \
  --max-loras 4 \
  --max-lora-rank 64 \
  --lora-modules "${LORA_MODULES[@]}" \
  > "${VLOG}" 2>&1 &
VLLM_PID=$!
echo "[hj4b] vllm serve ${MODEL} pid=${VLLM_PID} --enable-lora --max-loras 4 --max-lora-rank 64 --lora-modules ${LORA_MODULES[*]}"
t0=$(date +%s); deadline=$((t0 + 300)); healthy=0
while (( $(date +%s) < deadline )); do
  if ! kill -0 "${VLLM_PID}" 2>/dev/null; then
    echo "[hj4b] FATAL: vllm died before healthy; log tail:"; tail -n 60 "${VLOG}"; exit 1
  fi
  if curl -sf http://127.0.0.1:8000/v1/models >/dev/null 2>&1; then
    echo "[hj4b] vllm healthy after $(( $(date +%s) - t0 ))s"; healthy=1; break
  fi
  sleep 5
done
if [[ "${healthy}" -ne 1 ]]; then
  echo "[hj4b] FATAL: vllm not healthy within 300s"; tail -n 60 "${VLOG}"; kill_vllm; exit 1
fi

# ---- stage 1: smoke, then purge that smoke tree ------------------------------
echo "[hj4b] ---- stage 1 smoke (${SMOKE_CID}) ----"
timeout 120 rm -rf "${OUT:?}/${SMOKE_CID:?}"
SMOKE_CLEAR_RC=$?
if [[ "${SMOKE_CLEAR_RC}" -ne 0 ]]; then
  echo "[hj4b] FATAL: stale smoke purge failed (rc=${SMOKE_CLEAR_RC})"; kill_vllm; exit "${SMOKE_CLEAR_RC}"
fi
timeout 1800 "${PY}" -m sidekick.runner \
  --system fixed_k --split dev --tasks 3 --seeds 1 \
  --env appworld --workers 3 \
  --config "${CFG_DEV}" --out "${OUT}" --campaign-id "${SMOKE_CID}"
SMOKE_RC=$?
if [[ "${SMOKE_RC}" -ne 0 ]]; then
  echo "[hj4b] FATAL: smoke runner exited ${SMOKE_RC}"; kill_vllm; exit "${SMOKE_RC}"
fi
summarise_campaign "${SMOKE_CID}" "${CFG_DEV}"
SMOKE_GATE_RC=$?
if [[ "${SMOKE_GATE_RC}" -ne 0 ]]; then
  echo "[hj4b] FATAL: smoke gate failed (rc=${SMOKE_GATE_RC})"; kill_vllm; exit "${SMOKE_GATE_RC}"
fi
timeout 180 "${PY}" - "${OUT}/${SMOKE_CID}" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
rows = []
for path in sorted(root.rglob("result.json")):
    try:
        rows.append(json.loads(path.read_text(encoding="utf-8")))
    except (OSError, json.JSONDecodeError):
        pass
error_types = [row.get("error_type") for row in rows]
print(f"[hj4b] smoke episodes={len(rows)} error_types={error_types}")
sys.exit(0 if len(rows) == 3 and all(error_type is None for error_type in error_types) else 1)
PY
SMOKE_CHECK_RC=$?
if [[ "${SMOKE_CHECK_RC}" -ne 0 ]]; then
  echo "[hj4b] FATAL: smoke did not produce exactly 3 clean episodes"; kill_vllm; exit "${SMOKE_CHECK_RC}"
fi
timeout 120 rm -rf "${OUT:?}/${SMOKE_CID:?}"
PURGE_SMOKE_RC=$?
if [[ "${PURGE_SMOKE_RC}" -ne 0 ]]; then
  echo "[hj4b] FATAL: smoke purge failed (rc=${PURGE_SMOKE_RC})"; kill_vllm; exit "${PURGE_SMOKE_RC}"
fi

# ---- stage 2: held-out dev, 57 tasks x 2 seeds = 114 episodes ----------------
echo "[hj4b] ---- stage 2 dev (${DEV_CID}) ----"
timeout 16200 "${PY}" -m sidekick.runner \
  --system fixed_k --split dev --tasks 57 --seeds 1,2 \
  --env appworld --workers 6 \
  --config "${CFG_DEV}" --out "${OUT}" --campaign-id "${DEV_CID}"
DEV_RC=$?
summarise_campaign "${DEV_CID}" "${CFG_DEV}"
DEV_SUM_RC=$?
if [[ "${DEV_RC}" -ne 0 || "${DEV_SUM_RC}" -ne 0 ]]; then
  echo "[hj4b] FATAL: dev stage failed runner=${DEV_RC} summary=${DEV_SUM_RC}"; kill_vllm; exit 1
fi
archive_campaign "${DEV_CID}"
DEV_ARCHIVE_RC=$?
if [[ "${DEV_ARCHIVE_RC}" -ne 0 ]]; then
  kill_vllm; exit "${DEV_ARCHIVE_RC}"
fi

# ---- stage 3: train seed 3, resuming the existing seed 1/2 campaign -----------
echo "[hj4b] ---- stage 3 train seed 3 (${TRAIN_CID}) ----"
TRAIN_ARCHIVE_BASENAME="${TRAIN_CID}_s123"
if [[ "${TRAIN_ARCHIVE_BASENAME}" != "hj4_correction_train_20260917_s123" || \
      "${TRAIN_ARCHIVE_BASENAME}" == "${TRAIN_CID}" ]]; then
  echo "[hj4b] FATAL: stage 3 archive basename must be hj4_correction_train_20260917_s123; refusing to start"
  kill_vllm
  exit 2
fi
TRAIN_FIXED_K_ROOT="${OUT}/${TRAIN_CID}/fixed_k"
TRAIN_SEED1_BEFORE="$(count_episodes "${TRAIN_FIXED_K_ROOT}/1")"
TRAIN_SEED2_BEFORE="$(count_episodes "${TRAIN_FIXED_K_ROOT}/2")"
echo "[hj4b] train resume before seed1=${TRAIN_SEED1_BEFORE} seed2=${TRAIN_SEED2_BEFORE}"
if [[ "${TRAIN_SEED1_BEFORE}" -ne 90 || "${TRAIN_SEED2_BEFORE}" -ne 90 ]]; then
  echo "[hj4b] FATAL: expected 90 existing episodes in fixed_k/1 and fixed_k/2; refusing to start"
  kill_vllm
  exit 2
fi
timeout 16200 "${PY}" -m sidekick.runner \
  --system fixed_k --split train --tasks 90 --seeds 3 \
  --env appworld --workers 6 \
  --config "${CFG_TRAIN}" --out "${OUT}" --campaign-id "${TRAIN_CID}"
TRAIN_RC=$?
TRAIN_SEED1_AFTER="$(count_episodes "${TRAIN_FIXED_K_ROOT}/1")"
TRAIN_SEED2_AFTER="$(count_episodes "${TRAIN_FIXED_K_ROOT}/2")"
TRAIN_SEED3_AFTER="$(count_episodes "${TRAIN_FIXED_K_ROOT}/3")"
echo "[hj4b] train resume after seed1=${TRAIN_SEED1_AFTER} seed2=${TRAIN_SEED2_AFTER} seed3=${TRAIN_SEED3_AFTER}"
if [[ "${TRAIN_SEED1_AFTER}" -ne "${TRAIN_SEED1_BEFORE}" || \
      "${TRAIN_SEED2_AFTER}" -ne "${TRAIN_SEED2_BEFORE}" || \
      "${TRAIN_SEED3_AFTER}" -ne 90 ]]; then
  echo "[hj4b] FATAL: train resume invariant failed; seed1/2 changed or seed3 is not 90 episodes"
  kill_vllm
  exit 2
fi
summarise_campaign "${TRAIN_CID}" "${CFG_TRAIN}"
TRAIN_SUM_RC=$?
if [[ "${TRAIN_RC}" -ne 0 || "${TRAIN_SUM_RC}" -ne 0 ]]; then
  echo "[hj4b] FATAL: train seed 3 stage failed runner=${TRAIN_RC} summary=${TRAIN_SUM_RC}"; kill_vllm; exit 1
fi
archive_campaign "${TRAIN_CID}" "${TRAIN_ARCHIVE_BASENAME}"
TRAIN_ARCHIVE_RC=$?

kill_vllm
echo "[hj4b] done dev=${DEV_CID} train=${TRAIN_CID} archive_rc=${TRAIN_ARCHIVE_RC} end=$(date -Iseconds)"
exit "${TRAIN_ARCHIVE_RC}"

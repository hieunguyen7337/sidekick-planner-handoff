#!/bin/bash
#PBS -N hj4-correction
#PBS -q gpu_inter
#PBS -l select=1:ncpus=16:ngpus=1:mem=128gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs/hj4_correction.out
#
# HJ-4 correction data: serve granite-4.2-8b with the sft_b LoRA and run
# fixed_k (k=5) on the train split, replaying J2 cached plans. Reviews are
# live hosted calls. Do not submit until the J3 gate has been read.
# The --lora-modules alias MUST equal executor.lora_name in the campaign
# config or requests silently hit the base model.
#
# Job variables (override at qsub time):
#   ADAPTER_SFT_B, ALIAS_SFT_B
# Do NOT add reasoning-parser flags (G3); they parked generations in
# reasoning_content and looked like parse_error.

set -uo pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HOME=/scratch/n12194778/hf
export APPWORLD_ROOT=/scratch/n12194778/sidekick/appworld
export SIDEKICK_VENV=/scratch/n12194778/sidekick/env
export PATH="${SIDEKICK_VENV}/bin:${HOME}/.local/bin:${PATH}"
export PYTHONPATH="/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/src:${PYTHONPATH:-}"
# CODEX_HOME is deliberately NOT set: the default ~/.codex holds auth.json and the
# per-thread session transcripts. Repointing it at an empty dir strands credentials.
CU13="${SIDEKICK_VENV}/lib/python3.12/site-packages/nvidia/cu13"
if [[ -x "${CU13}/bin/nvcc" ]]; then
  export CUDA_HOME="${CU13}"; export CUDA_PATH="${CU13}"
  export PATH="${CU13}/bin:${PATH}"
  export LD_LIBRARY_PATH="${CU13}/lib:${CU13}/lib64:${LD_LIBRARY_PATH:-}"
fi
export VLLM_USE_FLASHINFER_SAMPLER=0
export FLASHINFER_CACHE_DIR=/scratch/n12194778/sidekick/logs/flashinfer_cache_u9
ulimit -n 65536 2>/dev/null || ulimit -n 16384 2>/dev/null || ulimit -n 8192 2>/dev/null || true
echo "[u9] ulimit -n soft=$(ulimit -Sn) hard=$(ulimit -Hn)"
export TORCHINDUCTOR_CACHE_DIR=/scratch/n12194778/sidekick/cache/inductor
export TRITON_CACHE_DIR=/scratch/n12194778/sidekick/cache/triton
mkdir -p "${TORCHINDUCTOR_CACHE_DIR}" "${TRITON_CACHE_DIR}" "${FLASHINFER_CACHE_DIR}"

REPO=/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15
export SIDEKICK_START_COMMIT="$(git -C "${REPO}" rev-parse HEAD 2>/dev/null || echo unknown)"
OUT=/scratch/n12194778/sidekick/results
LOGDIR=/scratch/n12194778/sidekick/logs
PY="${SIDEKICK_VENV}/bin/python"
SUM="${REPO}/scripts/setup/campaign_summarize.py"
MODEL=ibm-granite/granite-4.2-8b
VLOG="${LOGDIR}/hj4_correction_vllm.log"

# ---- LoRA aliases: MUST equal executor.lora_name in the campaign config ------
ALIAS_SFT_B="${ALIAS_SFT_B:-sft_b}"
ADAPTER_SFT_B="${ADAPTER_SFT_B:-/scratch/n12194778/sidekick/artifacts/adapters/sft_b_s123_granite8b}"

cd "${REPO}" || exit 1
mkdir -p "${LOGDIR}" "${OUT}/results" /scratch/n12194778/sidekick/codex_scratch

CFG="${CFG:-${REPO}/configs/hj4_correction.yaml}"
CID="${CID:-hj4_correction_train_20260917}"
if [[ ! -f "${CFG}" ]]; then
  echo "[hj4] FATAL: campaign config absent: ${CFG}"
  echo "[hj4] not starting vLLM. Static LoRA line that will be used:"
  echo "[hj4] --enable-lora --max-loras 4 --max-lora-rank 64 --lora-modules ${ALIAS_SFT_B}=${ADAPTER_SFT_B}"
  echo "[hj4] alias source: ALIAS_SFT_B, which must equal executor.lora_name"
  exit 2
fi

LORA_MODULES=()
register_lora () {
  local alias="$1"
  local path="$2"
  if [[ -z "${path}" ]]; then
    return 0
  fi
  if [[ ! -d "${path}" ]]; then
    echo "[hj4] FATAL: adapter path for alias ${alias} is not a directory: ${path}" >&2
    exit 2
  fi
  LORA_MODULES+=("${alias}=${path}")
  echo "[hj4] lora-module ${alias}=${path}"
}
register_lora "${ALIAS_SFT_B}" "${ADAPTER_SFT_B}"
if [[ "${#LORA_MODULES[@]}" -eq 0 ]]; then
  echo "[hj4] FATAL: no LoRA modules registered; set ADAPTER_SFT_B" >&2
  exit 2
fi

VLLM_PID=""

kill_vllm () {
  if [[ -n "${VLLM_PID}" ]] && kill -0 "${VLLM_PID}" 2>/dev/null; then
    kill "${VLLM_PID}" 2>/dev/null || true
    for _ in $(seq 1 12); do kill -0 "${VLLM_PID}" 2>/dev/null || break; sleep 5; done
    kill -9 "${VLLM_PID}" 2>/dev/null || true
    wait "${VLLM_PID}" 2>/dev/null || true
  fi
  pkill -f "vllm serve" 2>/dev/null || true
  pkill -f "EngineCore" 2>/dev/null || true
  sleep 5
  echo "[hj4] GPU after shutdown:"
  nvidia-smi --query-gpu=memory.used,utilization.gpu --format=csv,noheader || true
}

# Smoke-then-full-then-summarise. This arm DOES call the planner (reviews), so
# the gate keeps --expect-planner. Smoke campaign is wiped before and after.
run_arm () {
  local system="$1"
  local cfg="$2"
  local cid="$3"
  local scid="${cid}_smoke"
  local smoke_rc=0
  local gate_rc=0
  local camp_rc=0
  local sum_rc=0
  local gate_cmd=(--gate --expect-planner --expect-model gpt-5.6-luna)

  echo "[hj4] ---- arm ${cid} system=${system} ----"
  echo "[hj4] ---- purge broken runs from earlier attempts ----"
  timeout 120 "${PY}" "${SUM}" --out "${OUT}" --campaign-id "${cid}" --purge-broken 2>/dev/null | head -2

  rm -rf "${OUT:?}/${scid:?}"
  echo "[hj4] ---- smoke gate (${scid}) ----"
  timeout 1800 "${PY}" -m sidekick.runner \
    --system "${system}" --split train --tasks 3 --seeds 1 \
    --env appworld --workers 3 \
    --config "${cfg}" --campaign-id "${scid}" --out "${OUT}"
  smoke_rc=$?
  if [[ "${smoke_rc}" -ne 0 ]]; then
    echo "[hj4] FATAL: smoke runner exited ${smoke_rc} (${cid})"
    return "${smoke_rc}"
  fi
  timeout 180 "${PY}" "${SUM}" --out "${OUT}" --campaign-id "${scid}" \
    --config "${cfg}" --repo "${REPO}" \
    "${gate_cmd[@]}"
  gate_rc=$?
  if [[ "${gate_rc}" -ne 0 ]]; then
    echo "[hj4] FATAL: smoke gate failed (rc=${gate_rc}) (${cid})"
    return "${gate_rc}"
  fi
  rm -rf "${OUT:?}/${scid:?}"

  echo "[hj4] ---- full campaign (${cid}) ----"
  timeout 16200 "${PY}" -m sidekick.runner \
    --system "${system}" --split train --tasks 90 --seeds 1,2 \
    --env appworld --workers 6 \
    --config "${cfg}" --out "${OUT}" --campaign-id "${cid}"
  camp_rc=$?

  echo "[hj4] ---- summary + manifest (${cid}) ----"
  timeout 300 "${PY}" "${SUM}" \
    --out "${OUT}" --campaign-id "${cid}" \
    --config "${cfg}" \
    --manifest "${OUT}/results/${cid}/manifest.json" \
    "${gate_cmd[@]}" --repo "${REPO}"
  sum_rc=$?
  echo "[hj4] ${cid} manifest/gate rc=${sum_rc} campaign_rc=${camp_rc}"
  if [[ "${camp_rc}" -ne 0 ]]; then
    return "${camp_rc}"
  fi
  return "${sum_rc}"
}

# ---- preflight: the planner must be reachable BEFORE a GPU is held ------------
echo "[hj4] ---- preflight ----"
if ! command -v codex >/dev/null 2>&1; then
  echo "[hj4] FATAL: codex not on PATH"; exit 1
fi
if [[ ! -s "${HOME}/.codex/auth.json" ]]; then
  echo "[hj4] FATAL: ~/.codex/auth.json missing or empty -- planner cannot authenticate"
  exit 1
fi
echo "[hj4] codex $(codex --version 2>/dev/null || echo '?')"
echo "[hj4] auth.json present (contents never printed)"

# ---- vLLM: LoRA registered statically at launch --------------------------------
kill_vllm
# The --lora-modules line. Alias comes from ALIAS_SFT_B / executor.lora_name, not the directory name.
"${SIDEKICK_VENV}/bin/vllm" serve "${MODEL}" \
  --served-model-name "${MODEL}" \
  --dtype bfloat16 \
  --max-model-len 32768 \
  --host 127.0.0.1 --port 8000 \
  --gpu-memory-utilization 0.85 \
  --enable-lora \
  --max-loras 4 \
  --max-lora-rank 64 \
  --lora-modules "${LORA_MODULES[@]}" \
  > "${VLOG}" 2>&1 &
VLLM_PID=$!
echo "[hj4] vllm serve ${MODEL} pid=${VLLM_PID} --enable-lora --max-loras 4 --max-lora-rank 64 --lora-modules ${LORA_MODULES[*]}"
t0=$(date +%s); deadline=$((t0 + 300)); healthy=0
while (( $(date +%s) < deadline )); do
  if ! kill -0 "${VLLM_PID}" 2>/dev/null; then
    echo "[hj4] FATAL: vllm died before healthy; log tail:"; tail -n 60 "${VLOG}"; exit 1
  fi
  if curl -sf http://127.0.0.1:8000/v1/models >/dev/null 2>&1; then
    echo "[hj4] vllm healthy after $(( $(date +%s) - t0 ))s"; healthy=1; break
  fi
  sleep 5
done
if [[ "${healthy}" -ne 1 ]]; then
  echo "[hj4] FATAL: vllm not healthy within 300s"; tail -n 60 "${VLOG}"; kill_vllm; exit 1
fi

# One train arm against the one vLLM server. No probe phase: J4 collects data.
arm_rc=125
run_arm fixed_k "${CFG}" "${CID}"
arm_rc=$?
echo "[hj4] arm (${CID}) rc=${arm_rc}"

# Events tree is SFT(c) training data. Merge-safe copy: mkdir the CID dest
# then copy contents (trailing /.) so a pre-existing dest merges instead of nesting.
echo "[hj4] ---- archive events tree ----"
archive_rc=0
if mkdir -p "${HOME}/sidekick_data/${CID}" && cp -a "${OUT}/${CID}/." "${HOME}/sidekick_data/${CID}/"; then
  echo "[hj4] archive ok ${HOME}/sidekick_data/${CID}"
else
  archive_rc=$?
  echo "[hj4] WARNING: archive failed rc=${archive_rc}; campaign status preserved" >&2
fi

kill_vllm
echo "[hj4] done=$(date -Iseconds) arm_rc=${arm_rc} archive_rc=${archive_rc}"
if [[ "${arm_rc}" -ne 0 ]]; then
  exit "${arm_rc}"
fi
exit "${archive_rc}"

#!/bin/bash
#PBS -N hj3-eval
#PBS -q gpu_inter
#PBS -l select=1:ncpus=16:ngpus=1:mem=128gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs/hj3_eval.out
#
# HJ-3 dev evaluation: serve granite-4.2-8b with statically registered LoRA
# adapters and run sft_plan (and later sft_c / sft_b_plus / sidekick).
# Dynamic adapter loading was tried in G3 and failed; only --lora-modules at
# launch works. The alias MUST equal the eval config's executor.lora_name or
# requests silently hit the base model.
#
# Job variables (override at qsub time). Leave a path empty to skip that module:
#   ADAPTER_SFT_B, ALIAS_SFT_B
#   ADAPTER_SFT_C, ALIAS_SFT_C
#   ADAPTER_SFT_B_PLUS, ALIAS_SFT_B_PLUS
#   ADAPTER_SIDEKICK, ALIAS_SIDEKICK
# Do NOT add reasoning-parser flags (G3); they parked generations in
# reasoning_content and looked like parse_error.

set -uo pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HOME=/scratch/n12194778/hf
export APPWORLD_ROOT=/scratch/n12194778/sidekick/appworld
export SIDEKICK_VENV=/scratch/n12194778/sidekick/env
export PATH="${SIDEKICK_VENV}/bin:${HOME}/.local/bin:${PATH}"
export PYTHONPATH="/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/src:${PYTHONPATH:-}"
# CODEX_HOME is deliberately NOT set: the default ~/.codex holds auth.json and the
# per-thread session transcripts. Repointing it at an empty dir strands credentials.
CU13="${SIDEKICK_VENV}/lib/python3.12/site-packages/nvidia/cu13"
if [[ -x "${CU13}/bin/nvcc" ]]; then
  export CUDA_HOME="${CU13}"; export CUDA_PATH="${CU13}"
  export PATH="${CU13}/bin:${PATH}"
  export LD_LIBRARY_PATH="${CU13}/lib:${CU13}/lib64:${LD_LIBRARY_PATH:-}"
fi
export VLLM_USE_FLASHINFER_SAMPLER=0
export FLASHINFER_CACHE_DIR=/scratch/n12194778/sidekick/logs/flashinfer_cache_u9
ulimit -n 65536 2>/dev/null || ulimit -n 16384 2>/dev/null || ulimit -n 8192 2>/dev/null || true
echo "[u9] ulimit -n soft=$(ulimit -Sn) hard=$(ulimit -Hn)"
export TORCHINDUCTOR_CACHE_DIR=/scratch/n12194778/sidekick/cache/inductor
export TRITON_CACHE_DIR=/scratch/n12194778/sidekick/cache/triton
mkdir -p "${TORCHINDUCTOR_CACHE_DIR}" "${TRITON_CACHE_DIR}" "${FLASHINFER_CACHE_DIR}"

REPO=/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15
export SIDEKICK_START_COMMIT="$(git -C "${REPO}" rev-parse HEAD 2>/dev/null || echo unknown)"
OUT=/scratch/n12194778/sidekick/results
LOGDIR=/scratch/n12194778/sidekick/logs
PY="${SIDEKICK_VENV}/bin/python"
SUM="${REPO}/scripts/setup/campaign_summarize.py"
MODEL=ibm-granite/granite-4.2-8b
VLOG="${LOGDIR}/hj3_eval_vllm.log"

# ---- LoRA aliases: MUST equal executor.lora_name in the eval config ----------
ALIAS_SFT_B="${ALIAS_SFT_B:-sft_b}"
ADAPTER_SFT_B="${ADAPTER_SFT_B:-/scratch/n12194778/sidekick/artifacts/adapters/sft_b_granite8b}"
ALIAS_SFT_C="${ALIAS_SFT_C:-sft_c}"
ADAPTER_SFT_C="${ADAPTER_SFT_C:-}"
ALIAS_SFT_B_PLUS="${ALIAS_SFT_B_PLUS:-sft_b_plus}"
ADAPTER_SFT_B_PLUS="${ADAPTER_SFT_B_PLUS:-}"
ALIAS_SIDEKICK="${ALIAS_SIDEKICK:-sidekick}"
ADAPTER_SIDEKICK="${ADAPTER_SIDEKICK:-}"

cd "${REPO}" || exit 1
mkdir -p "${LOGDIR}" "${OUT}/results" /scratch/n12194778/sidekick/codex_scratch

CFG_SFT_B="${CFG_SFT_B:-${REPO}/configs/eval_sft_b.yaml}"
# Campaigns are another unit's configs. Do not hold an H100 (or require adapters)
# until those files exist.
if [[ ! -f "${CFG_SFT_B}" ]]; then
  echo "[hj3] eval config absent: ${CFG_SFT_B}"
  echo "[hj3] not starting vLLM. Static LoRA line that will be used:"
  echo "[hj3] --enable-lora --max-loras 4 --max-lora-rank 64 --lora-modules ${ALIAS_SFT_B}=${ADAPTER_SFT_B}"
  echo "[hj3] alias source: ALIAS_* job variables, which must equal executor.lora_name"
  exit 0
fi

LORA_MODULES=()
register_lora () {
  local alias="$1"
  local path="$2"
  if [[ -z "${path}" ]]; then
    return 0
  fi
  if [[ ! -d "${path}" ]]; then
    echo "[hj3] FATAL: adapter path for alias ${alias} is not a directory: ${path}" >&2
    exit 2
  fi
  LORA_MODULES+=("${alias}=${path}")
  echo "[hj3] lora-module ${alias}=${path}"
}
register_lora "${ALIAS_SFT_B}" "${ADAPTER_SFT_B}"
register_lora "${ALIAS_SFT_C}" "${ADAPTER_SFT_C}"
register_lora "${ALIAS_SFT_B_PLUS}" "${ADAPTER_SFT_B_PLUS}"
register_lora "${ALIAS_SIDEKICK}" "${ADAPTER_SIDEKICK}"
if [[ "${#LORA_MODULES[@]}" -eq 0 ]]; then
  echo "[hj3] FATAL: no LoRA modules registered; set ADAPTER_SFT_B (and friends)" >&2
  exit 2
fi

VLLM_PID=""

kill_vllm () {
  if [[ -n "${VLLM_PID}" ]] && kill -0 "${VLLM_PID}" 2>/dev/null; then
    kill "${VLLM_PID}" 2>/dev/null || true
    for _ in $(seq 1 12); do kill -0 "${VLLM_PID}" 2>/dev/null || break; sleep 5; done
    kill -9 "${VLLM_PID}" 2>/dev/null || true
    wait "${VLLM_PID}" 2>/dev/null || true
  fi
  pkill -f "vllm serve" 2>/dev/null || true
  pkill -f "EngineCore" 2>/dev/null || true
  sleep 5
  echo "[hj3] GPU after shutdown:"
  nvidia-smi --query-gpu=memory.used,utilization.gpu --format=csv,noheader || true
}

# ---- preflight: the planner must be reachable BEFORE a GPU is held ------------
# sft_plan allows executor ASKs, so a planner call is possible even though HJ-1
# measured zero of them.
echo "[hj3] ---- preflight ----"
if ! command -v codex >/dev/null 2>&1; then
  echo "[hj3] FATAL: codex not on PATH"; exit 1
fi
if [[ ! -s "${HOME}/.codex/auth.json" ]]; then
  echo "[hj3] FATAL: ~/.codex/auth.json missing or empty -- planner cannot authenticate"
  exit 1
fi
echo "[hj3] codex $(codex --version 2>/dev/null || echo '?')"
echo "[hj3] auth.json present (contents never printed)"

# ---- vLLM: LoRA registered statically at launch --------------------------------
kill_vllm
# The --lora-modules line. Alias comes from ALIAS_* / executor.lora_name, not the directory name.
"${SIDEKICK_VENV}/bin/vllm" serve "${MODEL}" \
  --served-model-name "${MODEL}" \
  --dtype bfloat16 \
  --max-model-len 32768 \
  --host 127.0.0.1 --port 8000 \
  --gpu-memory-utilization 0.85 \
  --enable-lora \
  --max-loras 4 \
  --max-lora-rank 64 \
  --lora-modules "${LORA_MODULES[@]}" \
  > "${VLOG}" 2>&1 &
VLLM_PID=$!
echo "[hj3] vllm serve ${MODEL} pid=${VLLM_PID} --enable-lora --max-loras 4 --max-lora-rank 64 --lora-modules ${LORA_MODULES[*]}"
t0=$(date +%s); deadline=$((t0 + 300)); healthy=0
while (( $(date +%s) < deadline )); do
  if ! kill -0 "${VLLM_PID}" 2>/dev/null; then
    echo "[hj3] FATAL: vllm died before healthy; log tail:"; tail -n 60 "${VLOG}"; exit 1
  fi
  if curl -sf http://127.0.0.1:8000/v1/models >/dev/null 2>&1; then
    echo "[hj3] vllm healthy after $(( $(date +%s) - t0 ))s"; healthy=1; break
  fi
  sleep 5
done
if [[ "${healthy}" -ne 1 ]]; then
  echo "[hj3] FATAL: vllm not healthy within 300s"; tail -n 60 "${VLOG}"; kill_vllm; exit 1
fi

# ---- smoke gate, in its own campaign, wiped every time ------------------------
# A gate that can pass or fail on cached results is not a gate. Separate _smoke
# campaign id, purge, then full run + manifest. sft_plan may ASK the planner.
CID="${CID:-hj3_sft_b_dev_20260916}"
SCID="${CID}_smoke"
CFG="${CFG_SFT_B}"

echo "[hj3] ---- purge broken runs from earlier attempts ----"
timeout 120 "${PY}" "${SUM}" --out "${OUT}" --campaign-id "${CID}" --purge-broken 2>/dev/null | head -2

rm -rf "${OUT:?}/${SCID:?}"
echo "[hj3] ---- smoke gate (${SCID}) ----"
timeout 1800 "${PY}" -m sidekick.runner \
  --system sft_plan --split dev --tasks 3 --seeds 1 \
  --env appworld --workers 3 \
  --config "${CFG}" --campaign-id "${SCID}" --out "${OUT}"
smoke_rc=$?
if [[ "${smoke_rc}" -ne 0 ]]; then
  echo "[hj3] FATAL: smoke runner exited ${smoke_rc}"; kill_vllm; exit 1
fi
timeout 180 "${PY}" "${SUM}" --out "${OUT}" --campaign-id "${SCID}" \
  --config "${CFG}" --repo "${REPO}" \
  --gate --expect-planner --expect-model gpt-5.6-luna
gate_rc=$?
if [[ "${gate_rc}" -ne 0 ]]; then
  echo "[hj3] FATAL: smoke gate failed (rc=${gate_rc})"; kill_vllm; exit 1
fi
rm -rf "${OUT:?}/${SCID:?}"

echo "[hj3] ---- full campaign ----"
timeout 10800 "${PY}" -m sidekick.runner \
  --system sft_plan --split dev --tasks 57 --seeds 1,2 \
  --env appworld --workers 6 \
  --config "${CFG}" --out "${OUT}" --campaign-id "${CID}"
camp_rc=$?

echo "[hj3] ---- summary + manifest ----"
timeout 300 "${PY}" "${SUM}" \
  --out "${OUT}" --campaign-id "${CID}" \
  --config "${CFG}" \
  --manifest "${OUT}/results/${CID}/manifest.json" \
  --gate --expect-planner --expect-model gpt-5.6-luna --repo "${REPO}"
sum_rc=$?
echo "[hj3] manifest/gate rc=${sum_rc} campaign_rc=${camp_rc}"

# ==============================================================================
# ADDITIONAL ARMS — uncomment once those eval configs exist. Same smoke-then-full
# structure, separate *_smoke campaign ids, purge, gate, manifest. The served
# --lora-modules alias MUST equal executor.lora_name in each CFG.
# CFG_SFT_C="${REPO}/configs/eval_sft_c.yaml"            # ALIAS_SFT_C / sft_c
# CFG_SFT_B_PLUS="${REPO}/configs/eval_sft_b_plus.yaml"  # ALIAS_SFT_B_PLUS
# CFG_SIDEKICK="${REPO}/configs/eval_sidekick.yaml"      # ALIAS_SIDEKICK
# CID_C=hj3_sft_c_dev_YYYYMMDD
# SCID_C="${CID_C}_smoke"
# rm -rf "${OUT:?}/${SCID_C:?}"
# timeout 1800 "${PY}" -m sidekick.runner --system sft_plan --split dev --tasks 3 \
#   --seeds 1 --env appworld --workers 3 --config "${CFG_SFT_C}" \
#   --campaign-id "${SCID_C}" --out "${OUT}"
# timeout 10800 "${PY}" -m sidekick.runner --system sft_plan --split dev --tasks 57 \
#   --seeds 1,2 --env appworld --workers 6 --config "${CFG_SFT_C}" \
#   --campaign-id "${CID_C}" --out "${OUT}"
# timeout 300 "${PY}" "${SUM}" --out "${OUT}" --campaign-id "${CID_C}" \
#   --config "${CFG_SFT_C}" --manifest "${OUT}/results/${CID_C}/manifest.json" \
#   --gate --expect-planner --expect-model gpt-5.6-luna --repo "${REPO}"
# ==============================================================================

kill_vllm
echo "[hj3] done=$(date -Iseconds) campaign_rc=${camp_rc}"
exit "${camp_rc}"

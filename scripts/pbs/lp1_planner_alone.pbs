#!/bin/bash
#PBS -N lp1-planner
#PBS -q gpu_inter
#PBS -l select=1:ncpus=12:ngpus=1:gpu_id=H100:mem=64gb
#PBS -l walltime=08:00:00
#PBS -o /mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs/
#PBS -e /mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs/
#
# LP-1: the planner_alone ceiling driven by a LOCALLY SERVED open-weight planner (U11),
# for the second-planner generality check. Zero hosted calls, so this may run while a
# hosted quota window is being spent elsewhere.
#
#   qsub -v SEEDS=1,2 scripts/pbs/lp1_planner_alone.pbs
#   qsub -v SEEDS=1,2,SMOKE_ONLY=1 scripts/pbs/lp1_planner_alone.pbs
#
# ⚠ gpu_id=H100 is pinned on the select line, not left to qsub-time memory. A 40 GB A100
# has twice taken a job on this box that needed an 80 GB card and died at load; the fix
# belongs in the file that trips it.
#
# ⚠ The planner serves on port 8001, NOT 8000. planner_alone never constructs an executor,
# but the prefix-replay arms that consume this campaign run an executor server on 8000 at
# the same time, and a port collision between them would be silent until the wrong model
# answered.
#
# ⚠ Model: Qwen/Qwen3-8B. Qwen3-32B and Qwen3.6-27B-FP8 are NOT usable here despite
# appearing in the HF cache -- their blobs are 512-byte LFS pointer stubs (the whole
# 32B is 16 MB on disk). Serving one needs a real ~65 GB download first. Verified
# 2026-09-23.
set -uo pipefail

REPO=/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15
SIDEKICK_VENV=/scratch/n12194778/sidekick/env
OUT=/scratch/n12194778/sidekick/results
LOGDIR="${REPO}/campaign/workers/logs"
mkdir -p "${LOGDIR}"

cd "${REPO}" || exit 1
export PYTHONPATH=src:.
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
# Qwen lives in the HOME cache; the scratch cache holds only the granite models. The two
# are separate and picking the wrong one produces a download attempt, not an error.
export HF_HOME="${HF_HOME:-${HOME}/.cache/huggingface}"
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"

MODEL="${MODEL:-Qwen/Qwen3-8B}"
PORT="${PORT:-8001}"
CFG="${CFG:-${REPO}/configs/lp1_planner_alone_cap81_qwen8b.yaml}"
DATE="${DATE:-20260923}"
CID="${CID:-lp1_planner_alone_cap81_qwen8b_${DATE}}"
SEEDS="${SEEDS:-1,2}"
TASKS="${TASKS:-57}"
SMOKE_ONLY="${SMOKE_ONLY:-0}"
SMOKE_SEED="${SEEDS%%,*}"

JOBTAG="${PBS_JOBID:-local}"
VLOG="${LOGDIR}/${CID}.${JOBTAG}_vllm.log"

VLLM_PID=""
kill_vllm() {
  if [[ -n "${VLLM_PID}" ]]; then
    kill -TERM -- -"${VLLM_PID}" 2>/dev/null || true
    for _ in $(seq 1 30); do
      kill -0 "${VLLM_PID}" 2>/dev/null || break
      sleep 1
    done
    kill -KILL -- -"${VLLM_PID}" 2>/dev/null || true
    wait "${VLLM_PID}" 2>/dev/null || true
  fi
  VLLM_PID=""
}
trap kill_vllm EXIT

echo "[lp1] model=${MODEL} port=${PORT} cid=${CID} seeds=${SEEDS} tasks=${TASKS}"
echo "[lp1] HF_HOME=${HF_HOME} offline=${HF_HUB_OFFLINE}"

# Refuse to start if something already holds the port: serving a second model on a busy
# port fails in ways that look like a bad planner rather than a bad setup.
if curl -sf "http://127.0.0.1:${PORT}/v1/models" >/dev/null 2>&1; then
  echo "[lp1] FATAL: port ${PORT} already serving; refusing to start a second planner"
  exit 1
fi

setsid "${SIDEKICK_VENV}/bin/vllm" serve "${MODEL}" \
  --served-model-name "${MODEL}" \
  --dtype bfloat16 \
  --max-model-len 32768 \
  --host 127.0.0.1 --port "${PORT}" \
  --gpu-memory-utilization 0.85 \
  > "${VLOG}" 2>&1 &
VLLM_PID=$!
echo "[lp1] vllm serve pid=${VLLM_PID} log=${VLOG}"

t0=$(date +%s); deadline=$((t0 + 600)); healthy=0
while (( $(date +%s) < deadline )); do
  if ! kill -0 "${VLLM_PID}" 2>/dev/null; then
    echo "[lp1] FATAL: vllm died before healthy; log tail:"; tail -n 60 "${VLOG}"; exit 1
  fi
  if curl -sf "http://127.0.0.1:${PORT}/v1/models" >/dev/null 2>&1; then
    echo "[lp1] vllm healthy after $(( $(date +%s) - t0 ))s"; healthy=1; break
  fi
  sleep 5
done
if [[ "${healthy}" -ne 1 ]]; then
  echo "[lp1] FATAL: vllm not healthy within 600s"; tail -n 60 "${VLOG}"; exit 1
fi

# Confirm the server is answering as the model we asked for. A silently different
# served-model-name would make every episode measure something we did not intend -- the
# same class of defect as the LoRA alias mismatch documented in hj12_prefix.pbs.
SERVED=$(curl -sf "http://127.0.0.1:${PORT}/v1/models" | jq -r '.data[0].id' 2>/dev/null)
if [[ "${SERVED}" != "${MODEL}" ]]; then
  echo "[lp1] FATAL: served model is '${SERVED}', expected '${MODEL}'"
  exit 1
fi
echo "[lp1] served model confirmed: ${SERVED}"

# Smoke on the SAME seed population as the full run, so its episodes are not orphans
# that inflate the campaign count.
echo "[lp1] smoke: 3 tasks, seed ${SMOKE_SEED}"
timeout 3600 "${SIDEKICK_VENV}/bin/python" -m sidekick.runner \
  --system planner_alone --split dev --tasks 3 --seeds "${SMOKE_SEED}" \
  --config "${CFG}" --out "${OUT}" --campaign-id "${CID}_smoke" --workers 3
smoke_rc=$?
echo "[lp1] smoke rc=${smoke_rc}"
if [[ "${smoke_rc}" -ne 0 ]]; then
  echo "[lp1] FATAL: smoke failed; not spending the full run"
  exit "${smoke_rc}"
fi

if [[ "${SMOKE_ONLY}" == "1" ]]; then
  echo "[lp1] SMOKE_ONLY=1; stopping before the full run"
  exit 0
fi

echo "[lp1] full: ${TASKS} tasks, seeds ${SEEDS}"
timeout 21600 "${SIDEKICK_VENV}/bin/python" -m sidekick.runner \
  --system planner_alone --split dev --tasks "${TASKS}" --seeds "${SEEDS}" \
  --config "${CFG}" --out "${OUT}" --campaign-id "${CID}" --workers 6
full_rc=$?
echo "[lp1] full rc=${full_rc} cid=${CID}"

# The exit code proves nothing -- job 25713123 exited 0 with 47/57 episodes crashed.
# Print the error_type distribution so the landing check reads data, not status.
echo "[lp1] episode error_type distribution:"
find "${OUT}/${CID}" -name result.json 2>/dev/null \
  | xargs -r jq -r '.error_type // "none"' 2>/dev/null \
  | sort | uniq -c | sort -rn

exit "${full_rc}"

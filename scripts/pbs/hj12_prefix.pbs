#!/bin/bash
#PBS -N hj12-prefix
#PBS -q gpu_inter
#PBS -l select=1:ncpus=12:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
# Output_Path is evaluated at qsub time and cannot interpolate ARMSET/DATE/CID
# (those are computed below). A path with no filename makes PBS write unique
# <job ID>.OU / .ER in this directory — two prefix jobs in parallel cannot
# share a file. The script also execs a live JOB_CID+jobid copy so a job
# that dies after startup still leaves a campaign-id log. Do not override -o/-e
# with a shared filename. Do NOT submit from a worker.
#   ARMS="hj12_prefix_m2 hj12_prefix_m4" DATE=20260922 SMOKE_ONLY=1
#   qsub -v ARMS="${ARMS}",DATE=${DATE},SMOKE_ONLY=${SMOKE_ONLY} scripts/pbs/hj12_prefix.pbs
#   SYSTEM=sft_plan overrides --system (harness check if prefix_handoff is missing).
#PBS -o /mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs/
#PBS -e /mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs/
#
# HJ-12 prefix-handoff: serve one base model at a time with its LoRA(s).
# Granite-4.2-8b uses sft_b_plus_iaware_granite8b (alias sft_b_plus) and
# sft_b_plus_handoff_granite8b (alias sft_b_plus_handoff) together in one serve.
# Qwen/Qwen3-8B uses sft_b_plus_iaware_qwen8b (alias sft_b_plus_qwen8b).
# Pending arms are grouped by executor.model; vLLM is restarted between
# groups. Zero hosted planner calls. ARMS="<stem> <stem>" overrides the
# full set. Never pattern-kill another job's vLLM server.
# Alias launched via --lora-modules MUST equal executor.lora_name or requests
# silently hit the base model. Both granite aliases must be in that list.
#
# Queue sizing copied from hj8_frontier.pbs (ncpus=12:ngpus=1:mem=64gb).
#   A non-interactive `qsub -q gpu_inter` is remapped to gpu_batch_exec
#   regardless of -q [OBSERVED docs/FOLLOWUPS.md:35-38,
#   docs/feasibility/m0_gates.md:30-35]. Tonight's train-sft submission
#   `qsub -q gpu_inter -l select=1:ncpus=12:ngpus=1:mem=64gb` landed on
#   gpu_batch_exec [OBSERVED qstat -fx 25449628.aqua Submit_arguments / queue].
#   Do NOT add qlist=gpu_inter_exec to select — that Can Never Run against
#   the hook's Resource_List.qlist=gpu_batch_exec
#   [OBSERVED docs/feasibility/m0_gates.md:35].
#   Closest finished analog (granite-4.2-8b + LoRA + smoke + 57×2 workers-6):
#     hj3-eval 25401780  RSS 12352792kb  cpupercent 130  requested 16/128gb
#     hj4b-dev 25404924  RSS 12477120kb  cpupercent 175  requested 16/128gb
#     [OBSERVED qstat -fx resources_used.mem / Resource_List.select]
#   Peak RSS ≈ 12 GB, so 64gb is ~5× headroom; 12 ncpus matches the working
#   granite eval/serve size (hj1a/hj15/G3) and tonight's train-sft request.
#   Walltime 04:00:00. Completed arms are skipped on resume.
#
# Job variables (override at qsub time):
#   ARMSET (free|all), ARMS (space-separated cid stems; overrides ARMSET),
#   DATE, ADAPTER_SFT_B_PLUS, ALIAS_SFT_B_PLUS,
#   ADAPTER_SFT_B_PLUS_HANDOFF, ALIAS_SFT_B_PLUS_HANDOFF,
#   ADAPTER_SFT_B_PLUS_QWEN, ALIAS_SFT_B_PLUS_QWEN, MODEL_QWEN, MODEL_GRANITE,
#   SYSTEM (default prefix_handoff), SEEDS (default 1,2; the HJ-18 arms need SEEDS=3)
#   Every selected prefix_handoff arm's handoff.source_campaign must already be complete for
#   SEEDS (hj12_require_complete_sources), so the default ARMSET=free refuses while any source
#   is partial or absent (HJ-18's holds seed 3 only) -- select arms with ARMS=... instead.
#   The LP prefix arms do not run here (they need a served planner): scripts/pbs/lp_live.pbs.
#   SMOKE_ONLY=1 (default 0): each pending arm runs its 3-task smoke and
#   gate, then stops before the 57×2 campaign. Job rc is the first failed
#   smoke/gate. Unset or 0 leaves the full run unchanged.
# Do NOT add reasoning-parser flags (G3); they parked generations in
# reasoning_content and looked like parse_error.

set -uo pipefail
# JOB_CID is not available at qsub. Compute it first and exec a live CID-named
# log so an early death still leaves a findable file. PBS's own Output_Path is
# the unique <job ID>.OU under campaign/workers/logs/ (see #PBS -o above).
ARMSET="${ARMSET:-free}"
DATE="${DATE:-$(date -u +%Y%m%d)}"
SMOKE_ONLY="${SMOKE_ONLY:-0}"
SYSTEM="${SYSTEM:-}"
JOB_CID="hj12_prefix_${ARMSET}_${DATE}"
JOBTAG="${PBS_JOBID:-nopbs}"
PBS_LOGDIR="/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs"
CID_OUT="${PBS_LOGDIR}/${JOB_CID}.${JOBTAG}.out"
if [[ "${HJ12_GUARD_SELFTEST:-0}" != "1" ]]; then
  mkdir -p "${PBS_LOGDIR}"
  exec >> "${CID_OUT}" 2>&1
fi
echo "[hj12] job_cid=${JOB_CID} armset=${ARMSET} arms=${ARMS:-} date=${DATE} smoke_only=${SMOKE_ONLY} system=${SYSTEM:-prefix_handoff} job=${JOBTAG} cid_out=${CID_OUT}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HOME=/scratch/n12194778/hf
export APPWORLD_ROOT=/scratch/n12194778/sidekick/appworld
export SIDEKICK_VENV=/scratch/n12194778/sidekick/env
export PATH="${SIDEKICK_VENV}/bin:${HOME}/.local/bin:${PATH}"
export PYTHONPATH="/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/src:${PYTHONPATH:-}"
# CODEX_HOME is deliberately NOT set: the default ~/.codex holds auth.json and the
# per-thread session transcripts. Repointing it at an empty dir strands credentials.
CU13="${SIDEKICK_VENV}/lib/python3.12/site-packages/nvidia/cu13"
if [[ -x "${CU13}/bin/nvcc" ]]; then
  export CUDA_HOME="${CU13}"; export CUDA_PATH="${CU13}"
  export PATH="${CU13}/bin:${PATH}"
  export LD_LIBRARY_PATH="${CU13}/lib:${CU13}/lib64:${LD_LIBRARY_PATH:-}"
fi
export VLLM_USE_FLASHINFER_SAMPLER=0
export FLASHINFER_CACHE_DIR=/scratch/n12194778/sidekick/logs/flashinfer_cache_u9
ulimit -n 65536 2>/dev/null || ulimit -n 16384 2>/dev/null || ulimit -n 8192 2>/dev/null || true
echo "[u9] ulimit -n soft=$(ulimit -Sn) hard=$(ulimit -Hn)"
export TORCHINDUCTOR_CACHE_DIR=/scratch/n12194778/sidekick/cache/inductor
export TRITON_CACHE_DIR=/scratch/n12194778/sidekick/cache/triton
mkdir -p "${TORCHINDUCTOR_CACHE_DIR}" "${TRITON_CACHE_DIR}" "${FLASHINFER_CACHE_DIR}"

REPO=/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15
if [[ "${HJ12_GUARD_SELFTEST:-0}" != "1" ]]; then
  export SIDEKICK_START_COMMIT="$(git -C "${REPO}" rev-parse HEAD 2>/dev/null || echo unknown)"
else
  export SIDEKICK_START_COMMIT="${SIDEKICK_START_COMMIT:-unknown}"
fi
OUT=/scratch/n12194778/sidekick/results
LOGDIR=/scratch/n12194778/sidekick/logs
PY="${PY:-${SIDEKICK_VENV}/bin/python}"
SUM="${REPO}/scripts/setup/campaign_summarize.py"
MODEL_GRANITE="${MODEL_GRANITE:-ibm-granite/granite-4.2-8b}"
MODEL_QWEN="${MODEL_QWEN:-Qwen/Qwen3-8B}"
MODEL="${MODEL:-${MODEL_GRANITE}}"
VLOG="${LOGDIR}/${JOB_CID}.${JOBTAG}_vllm.log"
echo "[hj12] vlog=${VLOG}"

# ---- LoRA aliases: MUST equal executor.lora_name in each eval config ---------
# Default is the intervention-aware adapter. Getting the older
# sft_b_plus_granite8b path here invalidates the experiment.
# loadable PEFT dir (adapter_config.json + weights), not merely a directory.
ALIAS_SFT_B_PLUS="${ALIAS_SFT_B_PLUS:-sft_b_plus}"
ADAPTER_SFT_B_PLUS="${ADAPTER_SFT_B_PLUS:-/scratch/n12194778/sidekick/artifacts/adapters/sft_b_plus_iaware_granite8b}"
ALIAS_SFT_B_PLUS_HANDOFF="${ALIAS_SFT_B_PLUS_HANDOFF:-sft_b_plus_handoff}"
ADAPTER_SFT_B_PLUS_HANDOFF="${ADAPTER_SFT_B_PLUS_HANDOFF:-/scratch/n12194778/sidekick/artifacts/adapters/sft_b_plus_handoff_granite8b}"
ALIAS_SFT_B_PLUS_QWEN="${ALIAS_SFT_B_PLUS_QWEN:-sft_b_plus_qwen8b}"
ADAPTER_SFT_B_PLUS_QWEN="${ADAPTER_SFT_B_PLUS_QWEN:-/scratch/n12194778/sidekick/artifacts/adapters/sft_b_plus_iaware_qwen8b}"
QWEN_HF_HOME="${QWEN_HF_HOME:-${HOME}/.cache/huggingface}"
GRANITE_HF_HOME="${GRANITE_HF_HOME:-/scratch/n12194778/hf}"
MAX_LORAS=4

N_SMOKE_TASKS=3
N_FULL_TASKS=57
# Allow a third seed without editing this script; the default exactly reproduces the
# original two-seed campaigns. The smoke slice must sample the SAME seed population as
# the full run, or its episodes are orphans that inflate the campaign count and waste time.
SEEDS="${SEEDS:-1,2}"
SMOKE_SEED="${SEEDS%%,*}"
N_FULL_SEEDS=$(awk -F, "{print NF}" <<< "${SEEDS}")
N_PLANNED=$((N_FULL_TASKS * N_FULL_SEEDS))

cd "${REPO}" || exit 1
if [[ "${HJ12_GUARD_SELFTEST:-0}" != "1" ]]; then
  mkdir -p "${LOGDIR}" "${OUT}/results" /scratch/n12194778/sidekick/codex_scratch
fi

# ---- config gate. Named in the failure line so a reader knows why we stopped.
# Another unit owns verify_configs.py; it may still exit non-zero. Wire it anyway.
if [[ "${HJ12_GUARD_SELFTEST:-0}" != "1" ]]; then
  echo "[hj12] ---- scripts/setup/verify_configs.py ----"
  timeout 300 "${PY}" "${REPO}/scripts/setup/verify_configs.py"
  VERIFY_RC=$?
  if [[ "${VERIFY_RC}" -ne 0 ]]; then
    echo "[hj12] FATAL: scripts/setup/verify_configs.py exited ${VERIFY_RC}; not starting vLLM"
    exit "${VERIFY_RC}"
  fi
fi

# system|config|cid_stem   — cid is ${cid_stem}_${DATE}. Each (arm, τ) is its own cid.
FREE_ARMS=(
  "prefix_handoff|${REPO}/configs/hj12_prefix_m2.yaml|hj12_prefix_m2"
  "prefix_handoff|${REPO}/configs/hj12_prefix_m4.yaml|hj12_prefix_m4"
  "prefix_handoff|${REPO}/configs/hj12_prefix_m6.yaml|hj12_prefix_m6"
  "prefix_handoff|${REPO}/configs/hj12_prefix_m7.yaml|hj12_prefix_m7"
  "prefix_handoff|${REPO}/configs/hj12_prefix_m8.yaml|hj12_prefix_m8"
  "prefix_handoff|${REPO}/configs/hj12_prefix_m9.yaml|hj12_prefix_m9"
  "prefix_handoff|${REPO}/configs/hj12_prefix_m10.yaml|hj12_prefix_m10"
  "prefix_handoff|${REPO}/configs/hj12_prefix_m11.yaml|hj12_prefix_m11"
  "prefix_handoff|${REPO}/configs/hj13_prefix_zs_m6.yaml|hj13_prefix_zs_m6"
  "prefix_handoff|${REPO}/configs/hj13_prefix_zs_m9.yaml|hj13_prefix_zs_m9"
  "prefix_handoff|${REPO}/configs/hj13_prefix_zs_m11.yaml|hj13_prefix_zs_m11"
  "prefix_handoff|${REPO}/configs/hj13_prefix_hf_m6.yaml|hj13_prefix_hf_m6"
  "prefix_handoff|${REPO}/configs/hj13_prefix_hf_m9.yaml|hj13_prefix_hf_m9"
  "prefix_handoff|${REPO}/configs/hj13_prefix_hf_m11.yaml|hj13_prefix_hf_m11"
  "executor_alone|${REPO}/configs/hj14_executor_alone.yaml|hj14_executor_alone"
  "sft_plan|${REPO}/configs/hj14_sft_plan.yaml|hj14_sft_plan"
  "prefix_handoff|${REPO}/configs/hj14_prefix_m2.yaml|hj14_prefix_m2"
  "prefix_handoff|${REPO}/configs/hj14_prefix_m4.yaml|hj14_prefix_m4"
  "prefix_handoff|${REPO}/configs/hj14_prefix_m6.yaml|hj14_prefix_m6"
  "prefix_handoff|${REPO}/configs/hj14_prefix_m7.yaml|hj14_prefix_m7"
  "prefix_handoff|${REPO}/configs/hj14_prefix_m8.yaml|hj14_prefix_m8"
  "prefix_handoff|${REPO}/configs/hj14_prefix_m9.yaml|hj14_prefix_m9"
  "prefix_handoff|${REPO}/configs/hj14_prefix_m10.yaml|hj14_prefix_m10"
  "prefix_handoff|${REPO}/configs/hj14_prefix_m11.yaml|hj14_prefix_m11"
  "prefix_handoff|${REPO}/configs/hj15_prefix_zsq_m6.yaml|hj15_prefix_zsq_m6"
  "prefix_handoff|${REPO}/configs/hj15_prefix_zsq_m9.yaml|hj15_prefix_zsq_m9"
  "prompt_only|${REPO}/configs/hj16_narrated_m9_zs.yaml|hj16_narrated_m9_zs"
  "prompt_only|${REPO}/configs/hj16_narrated_obs_m9_zs.yaml|hj16_narrated_obs_m9_zs"
  "sft_plan|${REPO}/configs/hj16_narrated_m9_bplus.yaml|hj16_narrated_m9_bplus"
  "sft_plan|${REPO}/configs/hj16_narrated_obs_m9_bplus.yaml|hj16_narrated_obs_m9_bplus"
  "executor_alone|${REPO}/configs/hj15_executor_alone_zsq.yaml|hj15_executor_alone_zsq"
  "prompt_only|${REPO}/configs/hj15_prompt_only_zsq.yaml|hj15_prompt_only_zsq"
  "prefix_handoff|${REPO}/configs/hj15_prefix_zsq_m11.yaml|hj15_prefix_zsq_m11"
  "prefix_handoff|${REPO}/configs/hj17_prefix_c81_zs_m6.yaml|hj17_prefix_c81_zs_m6"
  "prefix_handoff|${REPO}/configs/hj17_prefix_c81_zs_m9.yaml|hj17_prefix_c81_zs_m9"
  "prefix_handoff|${REPO}/configs/hj17_prefix_c81_zs_m11.yaml|hj17_prefix_c81_zs_m11"
  "prefix_handoff|${REPO}/configs/hj17_prefix_c81_bplus_m6.yaml|hj17_prefix_c81_bplus_m6"
  "prefix_handoff|${REPO}/configs/hj17_prefix_c81_bplus_m9.yaml|hj17_prefix_c81_bplus_m9"
  "prefix_handoff|${REPO}/configs/hj17_prefix_c81_bplus_m11.yaml|hj17_prefix_c81_bplus_m11"
  "prompt_only|${REPO}/configs/hj16_narrated_m6_zs.yaml|hj16_narrated_m6_zs"
  "prompt_only|${REPO}/configs/hj16_narrated_m11_zs.yaml|hj16_narrated_m11_zs"
  "sft_plan|${REPO}/configs/hj16_narrated_m6_bplus.yaml|hj16_narrated_m6_bplus"
  "sft_plan|${REPO}/configs/hj16_narrated_m11_bplus.yaml|hj16_narrated_m11_bplus"
  # HJ-19: the same Qwen adapter served with a prompt that matches training (no
  # chat_template_kwargs). Diagnostic A/B for the missing terminal action; see the
  # header of configs/hj19_sft_plan_qwen_notk.yaml.
  "sft_plan|${REPO}/configs/hj19_sft_plan_qwen_notk.yaml|hj19_sft_plan_qwen_notk"
  "prefix_handoff|${REPO}/configs/hj19_prefix_m11_qwen_notk.yaml|hj19_prefix_m11_qwen_notk"
  # HJ-18: seed-3 replays of the cap-81 planner sample. Same receivers, same depths,
  # third planner seed; pooled with the HJ-17 arms they take each contrast to 171 pairs.
  # Submit with SEEDS=3 -- the source campaign only contains seed 3.
  "prefix_handoff|${REPO}/configs/hj18_prefix_c81s3_zs_m6.yaml|hj18_prefix_c81s3_zs_m6"
  "prefix_handoff|${REPO}/configs/hj18_prefix_c81s3_zs_m9.yaml|hj18_prefix_c81s3_zs_m9"
  "prefix_handoff|${REPO}/configs/hj18_prefix_c81s3_zs_m11.yaml|hj18_prefix_c81s3_zs_m11"
  "prefix_handoff|${REPO}/configs/hj18_prefix_c81s3_bplus_m6.yaml|hj18_prefix_c81s3_bplus_m6"
  "prefix_handoff|${REPO}/configs/hj18_prefix_c81s3_bplus_m9.yaml|hj18_prefix_c81s3_bplus_m9"
  "prefix_handoff|${REPO}/configs/hj18_prefix_c81s3_bplus_m11.yaml|hj18_prefix_c81s3_bplus_m11"
  # The LP-1 / LP-2 prefix arms (configs/lp{1,2}_prefix_*.yaml) are NOT here and must not be:
  # prefix_handoff honours executor asks, and this script serves no planner, so every honoured
  # ask crashed on a closed port (PBS 25725094) -- outcome-linked crashes. They run through
  # scripts/pbs/lp_live.pbs ARMSET=lp1_prefix|lp2_prefix, which serves the local planner.
)

hj12_select_arms () {
  SELECTED_ARMS=()
  local all_specs valid_stems spec sys cfg s matches
  local -a given=()
  all_specs=("${FREE_ARMS[@]}")
  valid_stems=()
  for spec in "${all_specs[@]}"; do
    IFS='|' read -r sys cfg s <<<"${spec}"
    valid_stems+=("${s}")
  done
  if [[ -n "${ARMS:-}" ]]; then
    read -r -a given <<< "${ARMS}"
    local g
    for g in "${given[@]}"; do
      [[ -z "${g}" ]] && continue
      matches=()
      for spec in "${all_specs[@]}"; do
        IFS='|' read -r sys cfg s <<<"${spec}"
        if [[ "${s}" == "${g}" ]]; then
          matches+=("${spec}")
        fi
      done
      if [[ "${#matches[@]}" -eq 0 ]]; then
        echo "[hj12] FATAL: unknown ARMS stem ${g}; valid stems: ${valid_stems[*]}"
        exit 2
      fi
      if [[ "${#matches[@]}" -ne 1 ]]; then
        echo "[hj12] FATAL: ARMS stem ${g} matched ${#matches[@]} entries (need exactly one); valid stems: ${valid_stems[*]}"
        exit 2
      fi
      SELECTED_ARMS+=("${matches[0]}")
    done
    if [[ "${#SELECTED_ARMS[@]}" -eq 0 ]]; then
      echo "[hj12] FATAL: ARMS is set but no stems were parsed from: ${ARMS}; valid stems: ${valid_stems[*]}"
      exit 2
    fi
    echo "[hj12] ARMS override: ${#SELECTED_ARMS[@]} arms: ${given[*]}"
    return 0
  fi
  case "${ARMSET}" in
    free|all) SELECTED_ARMS=("${FREE_ARMS[@]}");;
    live)
      echo "[hj12] FATAL: ARMSET=live is not valid for hj12_prefix (all four arms are free); use ARMS=... or ARMSET=free|all"
      exit 2
      ;;
    *)
      echo "[hj12] FATAL: ARMSET must be free|all, got ${ARMSET}"
      exit 2
      ;;
  esac
}

# hj12_select_arms is invoked after helper functions / selftest dispatch below.

hj12_assert_selected_configs_exist () {
  local cfg_missing=0
  local spec _system cfg _stem
  for spec in "${SELECTED_ARMS[@]}"; do
    IFS='|' read -r _system cfg _stem <<<"${spec}"
    if [[ ! -f "${cfg}" ]]; then
      echo "[hj12] eval config absent: ${cfg}"
      cfg_missing=1
    fi
  done
  if [[ "${cfg_missing}" -ne 0 ]]; then
    echo "[hj12] not starting vLLM. Static LoRA line that will be used:"
    echo "[hj12] granite: --lora-modules ${ALIAS_SFT_B_PLUS}=${ADAPTER_SFT_B_PLUS}"
    echo "[hj12] granite: --lora-modules ${ALIAS_SFT_B_PLUS_HANDOFF}=${ADAPTER_SFT_B_PLUS_HANDOFF}"
    echo "[hj12] qwen:    --lora-modules ${ALIAS_SFT_B_PLUS_QWEN}=${ADAPTER_SFT_B_PLUS_QWEN}"
    echo "[hj12] alias source: ALIAS_SFT_B_PLUS / ALIAS_SFT_B_PLUS_HANDOFF / ALIAS_SFT_B_PLUS_QWEN, must equal executor.lora_name"
    exit 2
  fi
}

# Second, independent quota guard for the free set. Does not import sidekick;
# reads the YAML itself. make_planner treats type=="codex" as CodexExecPlanner
# and anything else as MockPlanner [OBSERVED src/sidekick/runner.py:102-114].
# A live planner with no packet_source can spend hosted quota. Cached packets
# with on_missing fail (config-side) still need this script-side check.
assert_free_configs_cannot_spend () {
  local configs=()
  local spec cfg
  for spec in "${FREE_ARMS[@]}"; do
    IFS='|' read -r _system cfg _stem <<<"${spec}"
    configs+=("${cfg}")
  done
  echo "[hj12] ---- free-set live-planner guard (${#configs[@]} configs) ----"
  timeout 120 "${PY}" - "${configs[@]}" <<'PY'
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    print("[hj12] FATAL: PyYAML missing; cannot inspect planner keys independently")
    sys.exit(2)

failed = 0
for raw in sys.argv[1:]:
    path = Path(raw)
    data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    if not isinstance(data, dict):
        print(f"[hj12] FATAL: {path} is not a mapping")
        failed = 1
        continue
    planner = data.get("planner") or {}
    if not isinstance(planner, dict):
        planner = {}
    kind = str(planner.get("type") or data.get("planner_type") or "mock")
    packet_source = planner.get("packet_source")
    if isinstance(packet_source, str):
        packet_source = packet_source.strip() or None
    print(f"[hj12] guard {path.name}: planner.type={kind!r} packet_source={'set' if packet_source else 'absent'}")
    if kind == "codex" and not packet_source:
        print(
            f"[hj12] FATAL: {path} names a live planner (type={kind!r}) without "
            "planner.packet_source — the free set must be incapable of spending quota"
        )
        failed = 1
sys.exit(failed)
PY
}

if [[ "${HJ12_GUARD_SELFTEST:-0}" != "1" ]]; then
  if [[ "${ARMSET}" == "free" || "${ARMSET}" == "all" ]]; then
    assert_free_configs_cannot_spend || exit $?
  fi
fi

# ---- replay sources: a prefix arm re-executes the first m actions of handoff.source_campaign.
# The default ARMSET=free selects every FREE_ARMS entry, including arms whose source holds only
# seed 3 (HJ-18, which must be submitted with SEEDS=3). scripts/pbs/lp_live.pbs ports this check
# (lp_require_complete_sources) for the LP prefix arms, whose sources are the LP ceilings.
# Against a partial source a replay episode either finds no events.jsonl -- effective_m=0, a
# handoff that silently never happened -- or replays an episode that crashed, which the source's
# next resubmission purges and re-plans, leaving this arm paired with a trajectory nobody scored.
# So every selected prefix_handoff arm's source must exist and hold, for EACH requested seed,
# >= N_FULL_TASKS result.json whose error_type is not "crash", with 0 crashed and 0 unreadable.
# Counted per seed rather than pooled: 114 seed-1 rows would pass a pooled >= 114 with seed 2
# absent. Rule and python body are require_complete_source in scripts/pbs/j10_arm.pbs, copied
# rather than sourced (sourcing that script would run its job). The full-campaign count applies
# under SMOKE_ONLY=1 too: a count cannot show that the three smoke tasks are among the rows
# present, and a smoke that passes on a partial source is a gate passing for the wrong reason.
# Returns 2 after one FATAL line per failing arm; the caller exits before any vLLM starts.
hj12_require_complete_sources () {
  local -a specs=()
  local spec system cfg stem rc
  for spec in "${SELECTED_ARMS[@]}"; do
    IFS='|' read -r system cfg stem <<<"${spec}"
    # SYSTEM overrides the system at run time (run_arm), so judge what will actually run too.
    if [[ "${system}" == "prefix_handoff" || "${SYSTEM:-}" == "prefix_handoff" ]]; then
      specs+=("${stem}|${cfg}")
    fi
  done
  if [[ "${#specs[@]}" -eq 0 ]]; then
    echo "[hj12] replay sources: no selected prefix_handoff arm; nothing to check"
    return 0
  fi
  echo "[hj12] ---- replay sources (${#specs[@]} prefix_handoff arms; need >= ${N_FULL_TASKS} non-crashed per seed, SEEDS=${SEEDS}) ----"
  timeout 600 "${PY}" - "${SEEDS}" "${N_FULL_TASKS}" "${specs[@]}" <<'PY'
import json
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    print("[hj12] FATAL: PyYAML missing; cannot read handoff.source_campaign; not starting vLLM")
    sys.exit(2)

seeds = [s.strip() for s in sys.argv[1].split(",") if s.strip()]
need = int(sys.argv[2])
if not seeds:
    print(f"[hj12] FATAL: SEEDS={sys.argv[1]!r} names no seed; cannot judge the replay sources")
    sys.exit(2)


def inspect(src):
    # require_complete_source (scripts/pbs/j10_arm.pbs), with the non-crashed count kept per seed.
    root = Path(src)
    ok = {s: 0 for s in seeds}
    crash = bad = 0
    if root.is_dir():
        for path in root.rglob("result.json"):
            try:
                row = json.loads(path.read_text(encoding="utf-8").strip() or "null")
            except (OSError, UnicodeDecodeError, json.JSONDecodeError):
                bad += 1
                continue
            if not isinstance(row, dict):
                bad += 1
            elif row.get("error_type") == "crash":
                crash += 1
            elif str(row.get("seed")) in ok:
                ok[str(row.get("seed"))] += 1
    return root.is_dir(), ok, crash, bad


seen = {}
failed = 0
for arg in sys.argv[3:]:
    stem, cfg = arg.split("|", 1)
    try:
        data = yaml.safe_load(Path(cfg).read_text(encoding="utf-8")) or {}
    except (OSError, yaml.YAMLError) as exc:
        print(f"[hj12] FATAL: arm {stem} config {cfg} is unreadable ({exc}); not starting vLLM")
        failed = 1
        continue
    handoff = data.get("handoff") if isinstance(data, dict) else None
    src = handoff.get("source_campaign") if isinstance(handoff, dict) else None
    src = str(src).strip() if src else ""
    if not src:
        print(f"[hj12] FATAL: arm {stem} config {cfg} has no handoff.source_campaign; not starting vLLM")
        failed = 1
        continue
    if src not in seen:
        seen[src] = inspect(src)
    exists, ok, crash, bad = seen[src]
    counts = (
        f"exists={int(exists)} non_crashed="
        + ",".join(f"seed{s}:{n}" for s, n in ok.items())
        + f" crashed={crash} unreadable={bad}"
    )
    if exists and crash == 0 and bad == 0 and all(n >= need for n in ok.values()):
        print(f"[hj12] replay source ok: arm {stem} source {src} {counts}")
        continue
    print(
        f"[hj12] FATAL: arm {stem} replay source {src} is not complete: {counts} "
        f"(need >= {need} non-crashed per seed for SEEDS={','.join(seeds)}, 0 crashed, "
        "0 unreadable); not starting vLLM"
    )
    failed = 1
sys.exit(2 if failed else 0)
PY
  rc=$?
  if [[ "${rc}" -ne 0 && "${rc}" -ne 2 ]]; then
    echo "[hj12] FATAL: could not inspect the replay sources (rc=${rc}); not starting vLLM"
  fi
  [[ "${rc}" -eq 0 ]] || return 2
}

# Crash convention (J10 / A1 §10.1, B2 prereg §3, LP prereg §3), the same as hj12_live.pbs:
# the only episode a resubmission may refill is one whose result.json says
# error_type == "crash", or one whose result.json is unreadable. timeout / parse_error /
# limit / api_error are SCORED outcomes of the arm. Through 2026-09-23 this file counted
# them as "broken" and ran --purge-broken, so every resubmission deleted and re-ran exactly
# the failed episodes: a second roll at the failures only, which biases the arm upward.

# n_runs / n_crashed over <OUT>/<cid>/**/result.json. n_crashed is the set
# campaign_summarize.purge_crashed deletes: error_type == "crash", or a result.json
# that is empty, not JSON, or not an object
# [OBSERVED scripts/setup/campaign_summarize.py:255-287].
campaign_stats () {
  local cid="$1"
  timeout 120 "${PY}" - "${OUT}" "${cid}" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1]) / sys.argv[2]
n = 0
nc = 0
if root.is_dir():
    for path in root.rglob("result.json"):
        n += 1
        try:
            text = path.read_text(encoding="utf-8").strip()
            data = json.loads(text) if text else None
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            data = None
        if not isinstance(data, dict) or data.get("error_type") == "crash":
            nc += 1
print(f"{n} {nc}")
PY
}

arm_is_complete () {
  local cid="$1"
  local n_runs n_crashed stats
  if [[ ! -f "${OUT}/results/${cid}/manifest.json" ]]; then
    return 1
  fi
  stats="$(campaign_stats "${cid}" || true)"
  read -r n_runs n_crashed <<<"${stats:-0 0}"
  n_runs="${n_runs:-0}"
  n_crashed="${n_crashed:-0}"
  [[ "${n_runs}" -eq "${N_PLANNED}" && "${n_crashed}" -eq 0 ]]
}

# Delete ONLY what campaign_stats counts as n_crashed (plus result-less attempt dirs),
# so the runner refills it. --purge-broken is the wrong tool on this path: it also
# deletes timeout / parse_error / api_error, which are scored (see above).
hj12_purge_crashed () {
  local cid="$1"
  echo "[hj12] ---- purge crashed runs from earlier attempts (timeout/parse_error/limit/api_error are scored and kept) ----"
  timeout 120 "${PY}" "${SUM}" --out "${OUT}" --campaign-id "${cid}" --purge-crashed-only 2>/dev/null | head -2
}

LORA_MODULES=()
register_lora () {
  local alias="$1"
  local path="$2"
  if [[ -z "${path}" ]]; then
    return 0
  fi
  if [[ ! -d "${path}" ]]; then
    echo "[hj12] FATAL: adapter path for alias ${alias} is not a directory: ${path}" >&2
    exit 2
  fi
  # vLLM 0.29 LoRAModel.from_local_checkpoint (non-tensorizer) requires a PEFT
  # layout: adapter_config.json plus one of adapter_model.safetensors /
  # adapter_model.bin / adapter_model.pt. PEFT's own save names are the first
  # two; vLLM also accepts .pt. A trainer output directory exists from step 0
  # with only trainer_state/ — do not treat "is a directory" as loadable.
  if [[ ! -f "${path}/adapter_config.json" ]]; then
    echo "[hj12] FATAL: adapter for alias ${alias} missing adapter_config.json: ${path}" >&2
    exit 2
  fi
  if [[ ! -f "${path}/adapter_model.safetensors" && ! -f "${path}/adapter_model.bin" && ! -f "${path}/adapter_model.pt" ]]; then
    echo "[hj12] FATAL: adapter for alias ${alias} missing weights file (need adapter_model.safetensors, adapter_model.bin, or adapter_model.pt): ${path}" >&2
    exit 2
  fi
  LORA_MODULES+=("${alias}=${path}")
  echo "[hj12] lora-module ${alias}=${path}"
}

hj12_executor_fields () {
  local cfg="$1"
  timeout 60 "${PY}" - "${cfg}" <<'PY'
import sys
from pathlib import Path
try:
    import yaml
except ImportError:
    print("[hj12] FATAL: PyYAML missing; cannot read executor.model", file=sys.stderr)
    sys.exit(2)
data = yaml.safe_load(Path(sys.argv[1]).read_text(encoding="utf-8")) or {}
if not isinstance(data, dict):
    print(f"[hj12] FATAL: {sys.argv[1]} is not a mapping", file=sys.stderr)
    sys.exit(2)
ex = data.get("executor") or {}
if not isinstance(ex, dict):
    ex = {}
model = str(ex.get("model") or "").strip()
lora = ex.get("lora_name")
if lora is None or str(lora).strip() in ("", "null", "None"):
    lora = ""
else:
    lora = str(lora).strip()
if not model:
    print(f"[hj12] FATAL: {sys.argv[1]} missing executor.model", file=sys.stderr)
    sys.exit(2)
print(f"{model}|{lora}")
PY
}

hj12_alias_adapter_for_model () {
  case "$1" in
    "${MODEL_GRANITE}")
      EXPECT_ALIAS="${ALIAS_SFT_B_PLUS}"
      ADAPTER_PATH="${ADAPTER_SFT_B_PLUS}"
      ;;
    "${MODEL_QWEN}")
      EXPECT_ALIAS="${ALIAS_SFT_B_PLUS_QWEN}"
      ADAPTER_PATH="${ADAPTER_SFT_B_PLUS_QWEN}"
      ;;
    *)
      echo "[hj12] FATAL: unknown executor base model $1 (known: ${MODEL_GRANITE} ${MODEL_QWEN})"
      exit 2
      ;;
  esac
}

hj12_hf_home_for_model () {
  case "$1" in
    "${MODEL_QWEN}")
      export HF_HOME="${QWEN_HF_HOME}"
      export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
      ;;
    *)
      export HF_HOME="${GRANITE_HF_HOME}"
      unset HF_HUB_OFFLINE || true
      ;;
  esac
  echo "[hj12] HF_HOME=${HF_HOME} HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-} for base=$1"
}


VLLM_PID=""
SMOKE_TREES=()

kill_vllm () {
  if [[ "${HJ12_GUARD_SELFTEST:-0}" == "1" ]]; then
    echo "[hj12] selftest: kill_vllm skipped (pid=${VLLM_PID:-})"
    return 0
  fi
  if [[ -n "${VLLM_PID}" ]]; then
    kill -TERM -- -"${VLLM_PID}" 2>/dev/null || true
    local _
    for _ in $(seq 1 12); do
      kill -0 "${VLLM_PID}" 2>/dev/null || break
      sleep 5
    done
    kill -KILL -- -"${VLLM_PID}" 2>/dev/null || true
    wait "${VLLM_PID}" 2>/dev/null || true
  fi
  sleep 5
  echo "[hj12] GPU after shutdown:"
  nvidia-smi --query-gpu=memory.used,utilization.gpu --format=csv,noheader || true
}
if [[ "${HJ12_GUARD_SELFTEST:-0}" != "1" ]]; then
  trap kill_vllm EXIT
fi

hj12_vllm_fatal () {
  echo "[hj12] FATAL: $*"
  if [[ -n "${VLOG:-}" && -f "${VLOG}" ]]; then
    echo "[hj12] vllm log tail:"
    tail -n 60 "${VLOG}" || true
  fi
  kill_vllm
  exit 1
}

hj12_port_listening () {
  local p="$1"
  ss -ltn 2>/dev/null | awk -v want="$p" '
    $1 == "LISTEN" {
      n = split($4, a, ":")
      if (n > 0 && a[n] == want) found = 1
    }
    END { exit found ? 0 : 1 }
  '
}

hj12_choose_vllm_port () {
  local raw jobnum tries
  raw="${PBS_JOBID%%.*}"
  jobnum="${raw//[^0-9]/}"
  if [[ -z "${jobnum}" ]]; then
    jobnum="$$"
  fi
  VLLM_PORT=$(( 20000 + jobnum % 20000 ))
  tries=0
  if ! command -v ss >/dev/null 2>&1; then
    echo "[hj12] WARN: ss not available; using derived VLLM_PORT=${VLLM_PORT} without LISTEN probe"
  else
    while hj12_port_listening "${VLLM_PORT}"; do
      tries=$((tries + 1))
      if [[ "${tries}" -ge 50 ]]; then
        echo "[hj12] FATAL: no free vLLM port after 50 tries (last=${VLLM_PORT})"
        exit 1
      fi
      VLLM_PORT=$((VLLM_PORT + 1))
      if [[ "${VLLM_PORT}" -ge 40000 ]]; then
        VLLM_PORT=20000
      fi
    done
  fi
  export VLLM_PORT
  export SIDEKICK_VLLM_BASE_URL="http://127.0.0.1:${VLLM_PORT}"
  echo "[hj12] vllm_port=${VLLM_PORT} base_url=${SIDEKICK_VLLM_BASE_URL}"
}

hj12_vllm_identity_check () {
  local body ids_file alias spec missing have ss_line listen_pid listen_pgid
  body=$(curl -sf "http://127.0.0.1:${VLLM_PORT}/v1/models") || hj12_vllm_fatal "/v1/models failed after the port answered"
  ids_file="$(mktemp)"
  printf '%s' "${body}" | "${PY}" -c '
import json, sys
raw = sys.stdin.read()
try:
    body = json.loads(raw or "null")
except json.JSONDecodeError as exc:
    sys.stderr.write(f"[hj12] FATAL: /v1/models body is not JSON: {exc}\n")
    sys.exit(2)
ids = []
if isinstance(body, dict):
    data = body.get("data")
    if isinstance(data, list):
        for item in data:
            if isinstance(item, dict) and item.get("id") is not None:
                ids.append(str(item["id"]))
    if body.get("id") is not None:
        ids.append(str(body["id"]))
print("\n".join(ids))
' > "${ids_file}" || hj12_vllm_fatal "/v1/models body is not JSON"
  missing=()
  have="$(tr '\n' ' ' < "${ids_file}")"
  if ! grep -Fxq "${MODEL}" "${ids_file}"; then
    rm -f "${ids_file}"
    hj12_vllm_fatal "vLLM /v1/models missing served base model ${MODEL} (have: ${have})"
  fi
  echo "[hj12] vllm identity: base_model=${MODEL} present in /v1/models"
  for spec in "${LORA_MODULES[@]}"; do
    alias="${spec%%=*}"
    if ! grep -Fxq "${alias}" "${ids_file}"; then
      missing+=("${alias}")
    fi
  done
  rm -f "${ids_file}"
  if [[ "${#missing[@]}" -ne 0 ]]; then
    hj12_vllm_fatal "vLLM /v1/models missing LoRA alias(es): ${missing[*]} (have: ${have})"
  fi
  echo "[hj12] vllm identity: all LoRA aliases present in /v1/models (${LORA_MODULES[*]%%=*})"

  if ! command -v ss >/dev/null 2>&1; then
    echo "[hj12] WARN: ss unavailable; skipping pgid identity check"
  else
    ss_line="$(ss -ltnp 2>/dev/null | awk -v p="${VLLM_PORT}" '
      $1 == "LISTEN" {
        n = split($4, a, ":")
        if (n > 0 && a[n] == p) { print; exit }
      }
    ')"
    if [[ -z "${ss_line}" ]]; then
      echo "[hj12] WARN: ss did not show a LISTEN on ${VLLM_PORT}; skipping pgid identity check"
    else
      listen_pid=""
      if [[ "${ss_line}" =~ pid=([0-9]+) ]]; then
        listen_pid="${BASH_REMATCH[1]}"
      fi
      if [[ -z "${listen_pid}" ]]; then
        echo "[hj12] WARN: ss LISTEN line for ${VLLM_PORT} has no pid=; skipping pgid identity check"
      else
        listen_pgid="$(ps -o pgid= -p "${listen_pid}" 2>/dev/null | tr -d '[:space:]')"
        if [[ "${listen_pgid}" != "${VLLM_PID}" ]]; then
          hj12_vllm_fatal "vLLM port ${VLLM_PORT} is held by pid=${listen_pid} pgid=${listen_pgid}, expected pgid=${VLLM_PID}"
        fi
        echo "[hj12] vllm identity: listen pid=${listen_pid} pgid=${listen_pgid} matches VLLM_PID"
      fi
    fi
  fi

  if [[ -n "${VLOG:-}" && -f "${VLOG}" ]] && grep -Eq 'port .* is used by process' "${VLOG}"; then
    hj12_vllm_fatal "vLLM log reports port is used by process"
  fi
}

hj12_print_smoke_escalation_table () {
  echo "[hj12] ---- smoke prefix-handoff table ----"
  echo "arm | n_episodes | effective_m_mean | handoff_occurred | hash_ok | replayed_planner_tokens | live_planner_calls"
  if [[ "${#SMOKE_TREES[@]}" -eq 0 ]]; then
    echo "[hj12] no smoke trees this pass"
    return 0
  fi
  local entry system stem scid line live
  for entry in "${SMOKE_TREES[@]}"; do
    IFS='|' read -r system stem scid <<<"${entry}"
    line="$(timeout 120 "${PY}" - "${OUT}" "${scid}" <<'PY'
import json
import sys
from pathlib import Path
from statistics import mean

root = Path(sys.argv[1]) / sys.argv[2]
n_episodes = 0
effective_ms = []
n_handoff = 0
n_hash_ok = 0
replayed_tokens = 0
live = 0
for path in sorted(root.rglob("result.json")):
    n_episodes += 1
for path in root.rglob("events.jsonl"):
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        continue
    events = []
    last_start = 0
    for raw in text.splitlines():
        raw = raw.strip()
        if not raw:
            continue
        try:
            ev = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if not isinstance(ev, dict):
            continue
        events.append(ev)
        if ev.get("event_type") == "run_start":
            last_start = len(events) - 1
        usage = ev.get("usage") or {}
        if ev.get("actor") == "planner" and usage.get("provider") == "codex":
            live += max(1, int(usage.get("n_calls") or 1))
    facts = {}
    for ev in events[last_start:]:
        payload = ev.get("payload") or {}
        if not isinstance(payload, dict):
            continue
        for key in ("effective_m", "handoff_occurred", "hash_ok", "replayed_planner_tokens"):
            if key in payload and payload[key] is not None:
                facts[key] = payload[key]
    if facts.get("effective_m") is not None:
        try:
            effective_ms.append(int(facts["effective_m"]))
        except (TypeError, ValueError):
            pass
    if facts.get("handoff_occurred") is True:
        n_handoff += 1
    if facts.get("hash_ok") is True:
        n_hash_ok += 1
    if facts.get("replayed_planner_tokens") is not None:
        try:
            replayed_tokens += int(facts["replayed_planner_tokens"])
        except (TypeError, ValueError):
            pass
eff_mean = round(mean(effective_ms), 2) if effective_ms else "NA"
print(f"{n_episodes} | {eff_mean} | {n_handoff} | {n_hash_ok} | {replayed_tokens} | {live}")
PY
)"
    echo "${stem} | ${line}"
    live="$(printf '%s' "${line}" | awk -F '|' '{gsub(/ /, "", $6); print $6}')"
    if [[ "${live}" != "0" && "${live}" != "NA" && -n "${live}" ]]; then
      echo "[hj12] WARN: live planner calls is ${live} on ${stem} — this arm must spend nothing hosted"
    fi
  done
}

hj12_run_guard_selftest () {
  if [[ -n "${HJ8_STUB_DIR:-}" ]]; then
    export PATH="${HJ8_STUB_DIR}:${PATH}"
  fi
  case "${GUARD_CASE:?}" in
    arms_unknown)
      ARMS="${ARMS_STEM:-not_a_real_stem}"
      hj12_select_arms
      echo "[hj12] UNREACHABLE: arms_unknown should have been FATAL"
      exit 99
      ;;
    health_missing_alias)
      export VLLM_PORT="${VLLM_PORT:-21001}"
      export VLLM_PID="${VLLM_PID:-12345}"
      VLOG="$(mktemp)"
      : > "${VLOG}"
      LORA_MODULES=("sft_b_plus=/tmp/r1_missing_alias")
      hj12_vllm_identity_check
      echo "[hj12] UNREACHABLE: health_missing_alias should have been FATAL"
      exit 99
      ;;
    health_foreign_pgid)
      export VLLM_PORT="${VLLM_PORT:-21002}"
      export VLLM_PID="${VLLM_PID:-11111}"
      VLOG="$(mktemp)"
      : > "${VLOG}"
      LORA_MODULES=("sft_b_plus=/tmp/r1_foreign_pgid")
      hj12_vllm_identity_check
      echo "[hj12] UNREACHABLE: health_foreign_pgid should have been FATAL"
      exit 99
      ;;
    source_check)
      # GUARD_SPECS ("system|config|stem" ..., space-separated) stands in for SELECTED_ARMS so a
      # test can point an arm at a synthetic source; unset, the real ARMS / ARMSET selection is
      # judged against the real sources (read-only).
      if [[ -n "${GUARD_SPECS:-}" ]]; then
        read -r -a SELECTED_ARMS <<< "${GUARD_SPECS}"
      else
        hj12_select_arms
      fi
      hj12_require_complete_sources || exit 2
      echo "[hj12] selftest: source_check passed (${#SELECTED_ARMS[@]} selected arms)"
      ;;
    resume_purge)
      # The resume path on a constructed tree, through the same helpers run_arm calls:
      # arm_is_complete before the purge, the crash-only purge, then the recount. Needs a
      # manifest under ${GUARD_OUT}/results/<cid>/ for "complete" to be reachable at all.
      OUT="${GUARD_OUT:?}"
      N_PLANNED="${GUARD_N_PLANNED:?}"
      local rp_cid="${GUARD_CID:?}" rp_before=0 rp_after=0 rp_stats rp_n rp_nc
      if arm_is_complete "${rp_cid}"; then rp_before=1; fi
      hj12_purge_crashed "${rp_cid}"
      rp_stats="$(campaign_stats "${rp_cid}" || true)"
      read -r rp_n rp_nc <<<"${rp_stats:-0 0}"
      if arm_is_complete "${rp_cid}"; then rp_after=1; fi
      echo "[hj12] selftest: resume_purge cid=${rp_cid} complete_before=${rp_before} n_runs=${rp_n} n_crashed=${rp_nc} n_planned=${N_PLANNED} complete_after=${rp_after}"
      ;;
    *)
      echo "[hj12] FATAL: unknown GUARD_CASE=${GUARD_CASE}"
      exit 2
      ;;
  esac
}

if [[ "${HJ12_GUARD_SELFTEST:-0}" == "1" ]]; then
  hj12_run_guard_selftest
  exit 0
fi

hj12_select_arms
hj12_assert_selected_configs_exist
hj12_require_complete_sources || exit 2

# Smoke-then-full-then-summarise for one arm. Args: system, config, campaign_id.
# SMOKE_ONLY=1 returns after smoke+gate (scid is still removed). Does not
# purge or write a manifest on the real cid, so a later full run
# still sees n_runs=0 and will smoke itself; an existing campaign is left
# intact. An arm that already has result.json still skips smoke.
# prefix_handoff must not pass --expect-planner: live planner calls must be
# zero (the prefix is replayed). --expect-planner would fail a healthy arm.
# SYSTEM=sft_plan (harness dry-run) keeps --expect-planner (cached packets).
run_arm () {
  local system="$1"
  local cfg="$2"
  local cid="$3"
  local stem="${4:-}"
  local scid="${cid}_smoke"
  local smoke_rc=0
  local gate_rc=0
  local camp_rc=0
  local sum_rc=0
  local n_runs=0
  local n_crashed=0
  local stats=""
  local gate_cmd=(--gate)
  if [[ -n "${SYSTEM:-}" ]]; then
    echo "[hj12] SYSTEM override ${system} -> ${SYSTEM}"
    system="${SYSTEM}"
  fi
  if [[ -z "${stem}" ]]; then
    stem="${cid%_${DATE}}"
  fi
  if [[ "${system}" != "executor_alone" && "${system}" != "prefix_handoff" ]]; then
    gate_cmd+=(--expect-planner --expect-model gpt-5.6-luna)
  fi

  echo "[hj12] ---- arm ${cid} system=${system} ----"
  if arm_is_complete "${cid}"; then
    echo "[hj12] resume: ${cid} already complete (${N_PLANNED} result.json, 0 crashed, manifest present); skipped"
    return 0
  fi

  if [[ "${SMOKE_ONLY}" == "1" ]]; then
    echo "[hj12] smoke_only: not purging ${cid} (will not touch a real campaign tree)"
  else
    hj12_purge_crashed "${cid}"
  fi

  # Same predicate as arm_is_complete, minus the manifest: scored timeout /
  # parse_error episodes count toward n_runs and never toward n_crashed.
  stats="$(campaign_stats "${cid}" || true)"
  read -r n_runs n_crashed <<<"${stats:-0 0}"
  n_runs="${n_runs:-0}"
  n_crashed="${n_crashed:-0}"
  echo "[hj12] resume: ${cid} n_runs=${n_runs} n_crashed=${n_crashed} n_planned=${N_PLANNED}"
  if [[ "${n_runs}" -eq "${N_PLANNED}" && "${n_crashed}" -eq 0 ]]; then
    if [[ "${SMOKE_ONLY}" == "1" ]]; then
      echo "[hj12] smoke_only: ${cid} has a full tree with 0 crashed; smoke skipped; not writing manifest"
      return 0
    fi
    echo "[hj12] resume: ${cid} has a full tree with 0 crashed; writing missing manifest"
    timeout 300 "${PY}" "${SUM}" \
      --out "${OUT}" --campaign-id "${cid}" \
      --config "${cfg}" \
      --manifest "${OUT}/results/${cid}/manifest.json" \
      "${gate_cmd[@]}" --repo "${REPO}"
    return $?
  fi

  if [[ "${n_runs}" -eq 0 ]]; then
    rm -rf "${OUT:?}/${scid:?}"
    echo "[hj12] ---- smoke gate (${scid}) ----"
    timeout 1800 "${PY}" -m sidekick.runner \
      --system "${system}" --split dev --tasks "${N_SMOKE_TASKS}" --seeds "${SMOKE_SEED}" \
      --env appworld --workers 3 \
      --config "${cfg}" --campaign-id "${scid}" --out "${OUT}"
    smoke_rc=$?
    if [[ "${SMOKE_ONLY}" == "1" ]]; then
      SMOKE_TREES+=("${system}|${stem}|${scid}")
    fi
    if [[ "${smoke_rc}" -ne 0 ]]; then
      echo "[hj12] FATAL: smoke runner exited ${smoke_rc} (${cid})"
      return "${smoke_rc}"
    fi
    timeout 180 "${PY}" "${SUM}" --out "${OUT}" --campaign-id "${scid}" \
      --config "${cfg}" --repo "${REPO}" \
      "${gate_cmd[@]}"
    gate_rc=$?
    if [[ "${gate_rc}" -ne 0 ]]; then
      echo "[hj12] FATAL: smoke gate failed (rc=${gate_rc}) (${cid})"
      return "${gate_rc}"
    fi
    if [[ "${SMOKE_ONLY}" != "1" ]]; then
      rm -rf "${OUT:?}/${scid:?}"
    fi
  else
    echo "[hj12] resume: ${cid} already has ${n_runs} result.json; smoke skipped"
  fi

  if [[ "${SMOKE_ONLY}" == "1" ]]; then
    echo "[hj12] smoke_only: ${cid} stopping before full campaign"
    return 0
  fi

  echo "[hj12] ---- full campaign (${cid}) ----"
  timeout 10800 "${PY}" -m sidekick.runner \
    --system "${system}" --split dev --tasks "${N_FULL_TASKS}" --seeds "${SEEDS}" \
    --env appworld --workers 6 \
    --config "${cfg}" --out "${OUT}" --campaign-id "${cid}"
  camp_rc=$?

  echo "[hj12] ---- summary + manifest (${cid}) ----"
  timeout 300 "${PY}" "${SUM}" \
    --out "${OUT}" --campaign-id "${cid}" \
    --config "${cfg}" \
    --manifest "${OUT}/results/${cid}/manifest.json" \
    "${gate_cmd[@]}" --repo "${REPO}"
  sum_rc=$?
  echo "[hj12] ${cid} manifest/gate rc=${sum_rc} campaign_rc=${camp_rc}"
  if [[ "${camp_rc}" -ne 0 ]]; then
    return "${camp_rc}"
  fi
  return "${sum_rc}"
}

PENDING_ARMS=()
PENDING_LIVE=0
echo "[hj12] ---- resume scan ----"
for spec in "${SELECTED_ARMS[@]}"; do
  IFS='|' read -r system cfg stem <<<"${spec}"
  cid="${stem}_${DATE}"
  if arm_is_complete "${cid}"; then
    echo "[hj12] resume: ${cid} complete; will not occupy the GPU for this arm"
    continue
  fi
  PENDING_ARMS+=("${spec}")
  case "${system}" in
    prefix_handoff|sft_plan|prompt_only|executor_alone) ;;
    *) PENDING_LIVE=1 ;;
  esac
done
if [[ "${ARMSET}" == "live" ]]; then
  echo "[hj12] FATAL: ARMSET=live is not valid for hj12_prefix"
  exit 2
fi
if [[ "${#PENDING_ARMS[@]}" -eq 0 ]]; then
  echo "[hj12] all ${ARMSET} arms already complete for DATE=${DATE}; not starting vLLM"
  echo "[hj12] done=$(date -Iseconds) pending=0"
  exit 0
fi
echo "[hj12] pending_arms=${#PENDING_ARMS[@]} pending_live=${PENDING_LIVE}"

# ---- preflight: live planner before a GPU is held. Skipped for ARMSET=free
# (and for all/live when the only remaining work is already complete, above).
if [[ "${PENDING_LIVE}" -eq 1 ]]; then
  echo "[hj12] ---- preflight (live planner) ----"
  if ! command -v codex >/dev/null 2>&1; then
    echo "[hj12] FATAL: codex not on PATH"; exit 1
  fi
  if [[ ! -s "${HOME}/.codex/auth.json" ]]; then
    echo "[hj12] FATAL: ~/.codex/auth.json missing or empty -- planner cannot authenticate"
    exit 1
  fi
  echo "[hj12] codex $(codex --version 2>/dev/null || echo '?')"
  echo "[hj12] auth.json present (contents never printed)"
else
  echo "[hj12] ---- preflight skipped (no pending live arm; free set must not call the planner) ----"
fi

# Group pending arms by executor.model. One vLLM process cannot serve granite
# and Qwen together; restart between groups. Each --lora-modules alias must
# equal executor.lora_name or requests silently hit BASE. Granite serves
# sft_b_plus and sft_b_plus_handoff together in one job.
SERVE_MODELS=()
for spec in "${PENDING_ARMS[@]}"; do
  IFS='|' read -r _system cfg _stem <<<"${spec}"
  fields="$(hj12_executor_fields "${cfg}")" || exit $?
  arm_model="${fields%%|*}"
  seen=0
  for already in "${SERVE_MODELS[@]+"${SERVE_MODELS[@]}"}"; do
    if [[ "${already}" == "${arm_model}" ]]; then
      seen=1
      break
    fi
  done
  if [[ "${seen}" -eq 0 ]]; then
    SERVE_MODELS+=("${arm_model}")
  fi
done

# A gate that can pass or fail on cached results is not a gate. Separate _smoke
# campaign id, purge, then full run + manifest. Continue after an arm failure so
# a later arm still gets walltime; the first non-zero rc is the job exit.
job_rc=0
for MODEL in "${SERVE_MODELS[@]}"; do
  export MODEL
  hj12_hf_home_for_model "${MODEL}"
  hj12_alias_adapter_for_model "${MODEL}"
  LORA_MODULES=()
  GROUP_ARMS=()
  ALLOWED_ALIASES=("${EXPECT_ALIAS}")
  if [[ "${MODEL}" == "${MODEL_GRANITE}" ]]; then
    ALLOWED_ALIASES=("${ALIAS_SFT_B_PLUS}" "${ALIAS_SFT_B_PLUS_HANDOFF}")
  fi
  need_expect=0
  need_handoff=0
  for spec in "${PENDING_ARMS[@]}"; do
    IFS='|' read -r system cfg stem <<<"${spec}"
    fields="$(hj12_executor_fields "${cfg}")" || exit $?
    arm_model="${fields%%|*}"
    arm_lora="${fields#*|}"
    if [[ "${arm_model}" != "${MODEL}" ]]; then
      continue
    fi
    if [[ -n "${arm_lora}" ]]; then
      alias_ok=0
      for allowed in "${ALLOWED_ALIASES[@]}"; do
        if [[ "${arm_lora}" == "${allowed}" ]]; then
          alias_ok=1
          break
        fi
      done
      if [[ "${alias_ok}" -eq 0 ]]; then
        echo "[hj12] FATAL: ${cfg} executor.lora_name=${arm_lora} not in served aliases ${ALLOWED_ALIASES[*]} for base ${MODEL}"
        exit 2
      fi
    fi
    if [[ "${arm_lora}" == "${EXPECT_ALIAS}" ]]; then
      need_expect=1
    fi
    if [[ "${arm_lora}" == "${ALIAS_SFT_B_PLUS_HANDOFF}" ]]; then
      need_handoff=1
    fi
    GROUP_ARMS+=("${spec}")
  done
  if [[ "${need_expect}" -eq 1 ]]; then
    echo "[hj12] serving_record base_model=${MODEL} alias=${EXPECT_ALIAS} adapter=${ADAPTER_PATH} n_arms=${#GROUP_ARMS[@]}"
    register_lora "${EXPECT_ALIAS}" "${ADAPTER_PATH}"
  fi
  if [[ "${need_handoff}" -eq 1 ]]; then
    echo "[hj12] serving_record base_model=${MODEL} alias=${ALIAS_SFT_B_PLUS_HANDOFF} adapter=${ADAPTER_SFT_B_PLUS_HANDOFF} n_arms=${#GROUP_ARMS[@]}"
    register_lora "${ALIAS_SFT_B_PLUS_HANDOFF}" "${ADAPTER_SFT_B_PLUS_HANDOFF}"
  fi
  if [[ "${#LORA_MODULES[@]}" -gt "${MAX_LORAS}" ]]; then
    echo "[hj12] FATAL: ${#LORA_MODULES[@]} LoRA modules exceeds --max-loras ${MAX_LORAS}: ${LORA_MODULES[*]}" >&2
    exit 2
  fi
  echo "[hj12] lora count ${#LORA_MODULES[@]} <= max-loras ${MAX_LORAS}"

  kill_vllm
  hj12_choose_vllm_port
  model_tag="${MODEL//\//_}"
  VLOG="${LOGDIR}/${JOB_CID}.${JOBTAG}_vllm_${model_tag}.log"
  echo "[hj12] vlog=${VLOG}"
  # The --lora-modules line. Alias comes from ALIAS_* / executor.lora_name, not the directory name.
  LORA_SERVE_FLAGS=()
  if [[ "${#LORA_MODULES[@]}" -gt 0 ]]; then
    LORA_SERVE_FLAGS=(
      --enable-lora
      --max-loras "${MAX_LORAS}"
      --max-lora-rank 64
      --lora-modules "${LORA_MODULES[@]}"
    )
  fi
  setsid "${SIDEKICK_VENV}/bin/vllm" serve "${MODEL}" \
    --served-model-name "${MODEL}" \
    --dtype bfloat16 \
    --max-model-len 32768 \
    --host 127.0.0.1 --port "${VLLM_PORT}" \
    --gpu-memory-utilization 0.85 \
    ${LORA_SERVE_FLAGS[@]+"${LORA_SERVE_FLAGS[@]}"} \
    > "${VLOG}" 2>&1 &
  VLLM_PID=$!
  echo "[hj12] vllm serve ${MODEL} pid=${VLLM_PID} port=${VLLM_PORT} ${LORA_SERVE_FLAGS[*]}"
  t0=$(date +%s); deadline=$((t0 + 300)); healthy=0
  while (( $(date +%s) < deadline )); do
    if ! kill -0 "${VLLM_PID}" 2>/dev/null; then
      echo "[hj12] FATAL: vllm died before healthy; log tail:"; tail -n 60 "${VLOG}"; exit 1
    fi
    if curl -sf "http://127.0.0.1:${VLLM_PORT}/v1/models" >/dev/null 2>&1; then
      echo "[hj12] vllm healthy after $(( $(date +%s) - t0 ))s"; healthy=1; break
    fi
    sleep 5
  done
  if [[ "${healthy}" -ne 1 ]]; then
    echo "[hj12] FATAL: vllm not healthy within 300s"; tail -n 60 "${VLOG}"; kill_vllm; exit 1
  fi
  hj12_vllm_identity_check

  for spec in "${GROUP_ARMS[@]}"; do
    IFS='|' read -r system cfg stem <<<"${spec}"
    cid="${stem}_${DATE}"
    arm_rc=125
    run_arm "${system}" "${cfg}" "${cid}" "${stem}"
    arm_rc=$?
    echo "[hj12] arm (${cid}) rc=${arm_rc} served_base=${MODEL} served_alias=${EXPECT_ALIAS}"
    if [[ "${arm_rc}" -ne 0 && "${job_rc}" -eq 0 ]]; then
      job_rc="${arm_rc}"
    fi
  done
  kill_vllm
done

if [[ "${SMOKE_ONLY}" == "1" ]]; then
  hj12_print_smoke_escalation_table
  for entry in "${SMOKE_TREES[@]}"; do
    IFS='|' read -r _system _stem scid <<<"${entry}"
    rm -rf "${OUT:?}/${scid:?}"
  done
fi

kill_vllm
echo "[hj12] done=$(date -Iseconds) job_rc=${job_rc} job_cid=${JOB_CID} pending_was=${#PENDING_ARMS[@]}"
exit "${job_rc}"

#!/bin/bash
#PBS -N lp-live
#PBS -q gpu_inter
#PBS -l select=1:ncpus=12:ngpus=1:gpu_id=H100:mem=64gb
#PBS -l walltime=10:00:00
#PBS -o /mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs/
#PBS -e /mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15/campaign/workers/logs/
#
# LP live arms: the hosted channel arms -- the matched-trigger pair (ledger CHAN-C1-02), the H2
# advice-at-price arm (CHAN-PRICE-01) and the sft_plan floor -- re-run with a LOCALLY SERVED
# open-weight planner, to test whether the channel result holds across planner strength (plan
# 2026-09-23, unit A3). Zero hosted calls. The configs are configs/lp{1,2}_*.yaml, generated by
# scripts/setup/make_lp_configs.py from their hosted sources.
# The LP prefix-replay arms (configs/lp{1,2}_prefix_*.yaml) run here too, with the planner SERVED:
# prefix_handoff honours executor asks (src/sidekick/systems/prefix_handoff.py:42), and an
# ASK_PLANNER with a plan present calls planner.correct() live (loop.py:1042), so a stuck
# executor's ask is answered by the same local planner, as hosted luna answered them in the
# published prefix arms. Under hj12_prefix.pbs, which serves no planner, every honoured ask
# crashed on a closed port (PBS 25725094); those ids are VOID and the arms carry *_v2_* ids.
#
#   LP-1, Qwen/Qwen3-8B -- planner and executor share ONE H100 at ~0.40 each:
#     qsub -v ARMSET=lp1 scripts/pbs/lp_live.pbs
#     qsub -v ARMSET=lp1_prefix scripts/pbs/lp_live.pbs
#   LP-2, Qwen/Qwen3.8-27B-FP8 (~31 GB of weights) -- one H100 per server, prefix arms included:
#     qsub -l select=1:ncpus=12:ngpus=2:gpu_id=H100:mem=96gb -v ARMSET=lp2 scripts/pbs/lp_live.pbs
#     qsub -l select=1:ncpus=12:ngpus=2:gpu_id=H100:mem=96gb -v ARMSET=lp2_prefix scripts/pbs/lp_live.pbs
#   One arm, smoke only:
#     qsub -v ARMS=lp1_hj12_takeover_fixed_k_10,SMOKE_ONLY=1 scripts/pbs/lp_live.pbs
#
# Job variables (qsub -v):
#   ARMSET       lp1 | lp2: the 4 live arms of that LP, and nothing else.
#                lp1_prefix | lp2_prefix: the 6 prefix-replay arms of that LP (zs/bplus x m6/9/11).
#                There is NO default -- a bare qsub must not choose a planner for you.
#   ARMS         space-separated config stems, live or prefix; overrides ARMSET. One job serves
#                one planner, so every arm must name the same planner.model.
#   SEEDS (1,2)  SMOKE_ONLY (0)  WORKERS (6)  SMOKE_TIMEOUT (3600 s)  FULL_TIMEOUT (21600 s/arm)
#   NGPU         default: the GPUs PBS made visible. Must agree with the select line.
#   PLACEMENT    shared (default when NGPU=1): both servers on the one card.
#                split  (default when NGPU>=2): executor on the first visible GPU, planner on
#                the second, each via its own CUDA_VISIBLE_DEVICES.
#   PLANNER_GPU_UTIL / EXECUTOR_GPU_UTIL   default 0.40 / 0.40 shared, 0.85 / 0.85 split
#   PLANNER_MAX_LEN (32768)  PLANNER_HF_HOME (chosen per model, below)
#   ADAPTER_SFT_B_PLUS, ALIAS_SFT_B_PLUS   (as scripts/pbs/hj12_live.pbs)
#
# Prefix arms, before any server starts: each one's handoff.source_campaign (its LP ceiling) must
#   hold, for every seed in SEEDS, >= 57 non-crashed episodes, with 0 crashed and 0 unreadable
#   (lp_require_complete_sources), else exit 2. Their gate is --allow-live-planner, not
#   --expect-planner (lp_gate_flags); they get no takeover check.
#
# Exit codes: 0 every selected arm complete and crash-free | 2 refused before any server
#   started | 3 an arm finished with crashed or missing episodes -- resubmit the same line:
#   completed episodes are skipped and crashed ones purged (ONLY error_type == "crash" or an
#   unreadable result.json; timeout/parse_error/limit/api_error are scored and kept) |
#   anything else: smoke/gate/infra.
#
# ⚠ gpu_id=H100 is pinned on the select line, not left to qsub-time memory. A 40 GB A100 has
#   twice taken a job on this box that needed an 80 GB card and died at load.
# ⚠ Two servers, two ports, both picked per job (20000 + job number, probed) and handed to the
#   runner through the environment -- SIDEKICK_VLLM_BASE_URL for the executor,
#   SIDEKICK_PLANNER_BASE_URL for the planner (src/sidekick/runner.py::resolve_*_base_url).
#   Never the configs' 8000/8001: two jobs can share a node, and a collision is silent until
#   the wrong model answers.
# ⚠ 0.40 + 0.40 on one card: an H100 holds Qwen3-8B plus granite-8B that way with room for KV.
#   The servers start ONE AFTER THE OTHER, executor first, so neither profiles free memory
#   while the other is still loading. The 27B FP8 planner does not fit beside granite at 0.40
#   and is refused on a shared card; give it ngpus=2.
# ⚠ HF_HOME is set PER SERVER. Granite lives in /scratch/n12194778/hf; Qwen3-8B in the home
#   cache; the 27B only in hf_planners -- its copy in ~/.cache/huggingface is SPARSE (30.9 GB
#   apparent, 0.02 GB allocated) and reads as zeros, which serves garbage rather than failing.
# ⚠ Only the GPU fraction differs from how the sources served granite (hj12_live.pbs, and
#   hj12_prefix.pbs for the prefix sources: same dtype, max-model-len, LoRA flags, alias). A
#   zero-shot prefix receiver (executor.lora_name null) asks for the base model, which the
#   executor server lists under its own name. The planner is served exactly as the LP ceiling
#   was (lp1_planner_alone.pbs), bar the fraction.
# Do NOT add reasoning-parser flags (G3); they parked generations in reasoning_content and
# looked like parse_error. The --lora-modules alias MUST equal executor.lora_name or requests
# silently hit the base model.
set -uo pipefail

REPO=/mnt/hpccs01/home/n12194778/iaes/.claude/worktrees/plan-2026-09-15
SELFTEST="${LP_SELFTEST:-0}"
JOBTAG="${PBS_JOBID:-nopbs$$}"
ARMSET="${ARMSET:-}"
ARMS="${ARMS:-}"
SMOKE_ONLY="${SMOKE_ONLY:-0}"
SEEDS="${SEEDS:-1,2}"
WORKERS="${WORKERS:-6}"
SMOKE_TIMEOUT="${SMOKE_TIMEOUT:-3600}"
FULL_TIMEOUT="${FULL_TIMEOUT:-21600}"
SMOKE_SEED="${SEEDS%%,*}"
N_SMOKE_TASKS=3
N_FULL_TASKS=57
N_FULL_SEEDS=$(awk -F, '{print NF}' <<< "${SEEDS}")
N_PLANNED=$((N_FULL_TASKS * N_FULL_SEEDS))

SIDEKICK_VENV=/scratch/n12194778/sidekick/env
OUT=/scratch/n12194778/sidekick/results
LOGDIR=/scratch/n12194778/sidekick/logs
PBS_LOGDIR="${REPO}/campaign/workers/logs"
PY="${PY:-${SIDEKICK_VENV}/bin/python}"
# LP_SUM exists for the resume_purge self-test, which must purge with the summarizer of the tree
# under test rather than REPO's.
SUM="${LP_SUM:-${REPO}/scripts/setup/campaign_summarize.py}"
MODEL_GRANITE="${MODEL_GRANITE:-ibm-granite/granite-4.2-8b}"
GRANITE_HF_HOME="${GRANITE_HF_HOME:-/scratch/n12194778/hf}"
ALIAS_SFT_B_PLUS="${ALIAS_SFT_B_PLUS:-sft_b_plus}"
ADAPTER_SFT_B_PLUS="${ADAPTER_SFT_B_PLUS:-/scratch/n12194778/sidekick/artifacts/adapters/sft_b_plus_iaware_granite8b}"
MAX_LORAS=4
PLANNER_MAX_LEN="${PLANNER_MAX_LEN:-32768}"

# system|config|stem. The system is the source arm's (hj12_live.pbs LIVE_ARMS, hj8 sft_plan,
# hj12_prefix.pbs FREE_ARMS for the hj17 prefix sources). A stem is its config's file stem; the
# campaign id is the config's own campaign_id (the prefix arms' carry _v2_).
LP_ARMS=(
  "fixed_k|${REPO}/configs/lp1_hj12_takeover_fixed_k_10.yaml|lp1_hj12_takeover_fixed_k_10"
  "fixed_k|${REPO}/configs/lp1_hj12_advise_fixed_k_10_fullctx.yaml|lp1_hj12_advise_fixed_k_10_fullctx"
  "fixed_k|${REPO}/configs/lp1_hj13_advise_fixed_k_1_fullctx.yaml|lp1_hj13_advise_fixed_k_1_fullctx"
  "sft_plan|${REPO}/configs/lp1_hj8_sft_plan_bplus.yaml|lp1_hj8_sft_plan_bplus"
  "fixed_k|${REPO}/configs/lp2_hj12_takeover_fixed_k_10.yaml|lp2_hj12_takeover_fixed_k_10"
  "fixed_k|${REPO}/configs/lp2_hj12_advise_fixed_k_10_fullctx.yaml|lp2_hj12_advise_fixed_k_10_fullctx"
  "fixed_k|${REPO}/configs/lp2_hj13_advise_fixed_k_1_fullctx.yaml|lp2_hj13_advise_fixed_k_1_fullctx"
  "sft_plan|${REPO}/configs/lp2_hj8_sft_plan_bplus.yaml|lp2_hj8_sft_plan_bplus"
  "prefix_handoff|${REPO}/configs/lp1_prefix_zs_m6.yaml|lp1_prefix_zs_m6"
  "prefix_handoff|${REPO}/configs/lp1_prefix_zs_m9.yaml|lp1_prefix_zs_m9"
  "prefix_handoff|${REPO}/configs/lp1_prefix_zs_m11.yaml|lp1_prefix_zs_m11"
  "prefix_handoff|${REPO}/configs/lp1_prefix_bplus_m6.yaml|lp1_prefix_bplus_m6"
  "prefix_handoff|${REPO}/configs/lp1_prefix_bplus_m9.yaml|lp1_prefix_bplus_m9"
  "prefix_handoff|${REPO}/configs/lp1_prefix_bplus_m11.yaml|lp1_prefix_bplus_m11"
  "prefix_handoff|${REPO}/configs/lp2_prefix_zs_m6.yaml|lp2_prefix_zs_m6"
  "prefix_handoff|${REPO}/configs/lp2_prefix_zs_m9.yaml|lp2_prefix_zs_m9"
  "prefix_handoff|${REPO}/configs/lp2_prefix_zs_m11.yaml|lp2_prefix_zs_m11"
  "prefix_handoff|${REPO}/configs/lp2_prefix_bplus_m6.yaml|lp2_prefix_bplus_m6"
  "prefix_handoff|${REPO}/configs/lp2_prefix_bplus_m9.yaml|lp2_prefix_bplus_m9"
  "prefix_handoff|${REPO}/configs/lp2_prefix_bplus_m11.yaml|lp2_prefix_bplus_m11"
)

lp_select_arms () {
  SELECTED=()
  local -a want=()
  local spec _sys _cfg stem g matches lp
  if [[ -n "${ARMS}" ]]; then
    read -r -a want <<< "${ARMS}"
  elif [[ "${ARMSET}" =~ ^lp[12](_prefix)?$ ]]; then
    # lp1 / lp2 select the live arms ONLY; lp1_prefix / lp2_prefix the prefix-replay arms only.
    # By system, not by stem prefix: every prefix stem also starts with "lp1_" / "lp2_".
    lp="${ARMSET%_prefix}"
    for spec in "${LP_ARMS[@]}"; do
      IFS='|' read -r _sys _cfg stem <<< "${spec}"
      [[ "${stem}" == "${lp}_"* ]] || continue
      if [[ "${ARMSET}" == *_prefix ]]; then
        [[ "${_sys}" == "prefix_handoff" ]] && want+=("${stem}")
      else
        [[ "${_sys}" != "prefix_handoff" ]] && want+=("${stem}")
      fi
    done
  else
    echo "[lp] FATAL: set ARMSET=lp1|lp2|lp1_prefix|lp2_prefix or ARMS=\"<stem> ...\" (got ARMSET='${ARMSET}', ARMS empty)"
    exit 2
  fi
  for g in "${want[@]}"; do
    matches=()
    for spec in "${LP_ARMS[@]}"; do
      IFS='|' read -r _sys _cfg stem <<< "${spec}"
      [[ "${stem}" == "${g}" ]] && matches+=("${spec}")
    done
    if [[ "${#matches[@]}" -ne 1 ]]; then
      echo "[lp] FATAL: ARMS stem '${g}' matched ${#matches[@]} entries; known: $(printf '%s ' "${LP_ARMS[@]##*|}")"
      exit 2
    fi
    SELECTED+=("${matches[0]}")
  done
  if [[ "${#SELECTED[@]}" -eq 0 ]]; then
    echo "[lp] FATAL: no arms selected"
    exit 2
  fi
}

# The refusal the unit exists for: every arm must drive a LOCAL planner. A codex arm here would
# spend hosted quota under an LP name; a mock (a mistyped planner.type) measures nothing and
# still scores. Prefix-replay configs pass it on the same terms (vllm, the job's one model); only
# they may name a zero-shot receiver. Reads the YAML itself rather than importing sidekick.
# Prints one ARM| line per config and a single PLANNER_MODEL| line; exits non-zero on any refusal.
lp_planner_guard () {
  timeout 120 "${PY}" - "${ALIAS_SFT_B_PLUS}" "${MODEL_GRANITE}" "$@" <<'PY'
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    print("[lp] FATAL: PyYAML missing; cannot inspect planner keys")
    sys.exit(2)

alias, granite = sys.argv[1], sys.argv[2]
failed = 0
models = set()
cids = {}
for raw in sys.argv[3:]:
    path = Path(raw)
    data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    planner = data.get("planner") or {}
    ex = data.get("executor") or {}
    if not isinstance(planner, dict) or not isinstance(ex, dict):
        print(f"[lp] FATAL: {path.name}: planner/executor is not a mapping")
        failed = 1
        continue
    kind = str(planner.get("type") or data.get("planner_type") or "mock")
    model = str(planner.get("model") or "").strip()
    # A prefix-replay arm (it has a handoff block) drives the same served planner as a live arm:
    # prefix_handoff answers executor asks live. Its receiver may be zero-shot.
    prefix = isinstance(data.get("handoff"), dict)
    print(f"[lp] guard {path.name}: arm={'prefix' if prefix else 'live'} planner.type={kind!r} model={model!r} "
          f"executor.lora_name={ex.get('lora_name')!r}")
    if kind != "vllm":
        print(f"[lp] FATAL: {path.name}: planner.type={kind!r}, need 'vllm' -- lp_live serves a LOCAL "
              "planner; a codex arm would spend hosted quota and a mock one measures nothing")
        failed = 1
        continue
    if not model:
        print(f"[lp] FATAL: {path.name}: planner.model is empty")
        failed = 1
        continue
    models.add(model)
    if str(ex.get("type")) != "vllm" or str(ex.get("model")) != granite:
        print(f"[lp] FATAL: {path.name}: executor must be vllm {granite}, got {ex.get('type')!r} {ex.get('model')!r}")
        failed = 1
    if prefix and ex.get("lora_name") is None:
        # The zero-shot receiver: an explicit null asks for base granite, which the executor
        # server lists under its own name (lp_identity checks it). Not a silent fallback.
        pass
    elif ex.get("lora_name") != alias:
        print(f"[lp] FATAL: {path.name}: executor.lora_name={ex.get('lora_name')!r} but this job registers only "
              f"alias {alias!r}; a mismatch silently hits the BASE model")
        failed = 1
    cid = str(data.get("campaign_id") or "").strip()
    if not cid or cid in cids:
        print(f"[lp] FATAL: {path.name}: campaign_id {cid!r} missing or shared with {cids.get(cid)}")
        failed = 1
    cids[cid] = path.name
    k = data.get("fixed_k")
    live_keys = ",".join(str(x) for x in (planner.get("live_plan_keys") or []))
    print(f"ARM|{path}|{cid}|{planner.get('packet_source') or ''}|{planner.get('packet_system') or 'planner_alone'}|{'' if k is None else k}|{live_keys}")
if len(models) > 1:
    print(f"[lp] FATAL: one job serves one planner; the selected arms name {sorted(models)}")
    failed = 1
if not failed and models:
    print(f"PLANNER_MODEL|{models.pop()}")
sys.exit(failed)
PY
}

# ---- resume bookkeeping (defined before the self-tests, which exercise it) --------------------
# Crash convention (J10 / A1 §10.1, B2 prereg §3): the only episode a resubmission may refill is
# one whose result.json says error_type == "crash", or one whose result.json is unreadable.
# timeout / parse_error / limit / api_error are SCORED outcomes of the arm. Counting them as
# "broken" -- as this file did through 2026-09-23 with --purge-broken and
# campaign_summarize.BROKEN -- deleted and re-ran exactly the failed episodes on every
# resubmission, a second roll at the failures only, which biases the arm upward; and an arm
# holding a scored parse_error could never count as complete. Same fix as hj12_live.pbs
# (commit 72899b5).
lp_n_runs () { find "${OUT}/$1" -name result.json 2>/dev/null | wc -l; }

# "<n_runs> <n_crashed>" over <OUT>/<cid>/**/result.json. n_crashed is the set
# campaign_summarize.purge_crashed deletes: error_type == "crash", or a result.json that is
# empty, not JSON, or not an object [scripts/setup/campaign_summarize.py:255-301].
lp_campaign_stats () {
  timeout 120 "${PY}" - "${OUT}" "$1" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1]) / sys.argv[2]
n = 0
nc = 0
if root.is_dir():
    for path in root.rglob("result.json"):
        n += 1
        try:
            text = path.read_text(encoding="utf-8").strip()
            data = json.loads(text) if text else None
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            data = None
        if not isinstance(data, dict) or data.get("error_type") == "crash":
            nc += 1
print(f"{n} {nc}")
PY
}

lp_arm_complete () {
  local cid="$1" stats n_runs n_crashed
  [[ -f "${OUT}/results/${cid}/manifest.json" ]] || return 1
  stats="$(lp_campaign_stats "${cid}" || true)"
  read -r n_runs n_crashed <<< "${stats:-0 0}"
  [[ "${n_runs:-0}" -eq "${N_PLANNED}" && "${n_crashed:-0}" -eq 0 ]]
}

# Delete ONLY what lp_campaign_stats counts as n_crashed (plus result-less attempt dirs), so the
# runner refills it. --purge-broken is the wrong tool here: it also deletes scored episodes.
lp_purge_crashed () {
  echo "[lp] purge crashed runs of $1 (timeout/parse_error/limit/api_error are scored and kept)"
  timeout 300 "${PY}" "${SUM}" --out "${OUT}" --campaign-id "$1" --purge-crashed-only 2>/dev/null | head -n 2
}

# The replayed first plans. on_missing: fail would abort each episode whose plan the ceiling has
# not written -- after both servers were paid for -- so count plan events before starting them.
# One jq verdict per file (-n + inputs): jq 1.6's -e reflects only the LAST input line, and the
# per-line form this used until 2026-09-23 counted a task only when its plan was the final event
# -- never, since run_end follows it -- so every arm would have been refused as "incomplete".
lp_plan_count () {
  local root="$1" n=0 f
  for f in "${root}"/*/events.jsonl; do
    [[ -f "${f}" ]] || continue
    jq -R -n -e '[inputs | fromjson? | select(.event_type == "plan")] | length > 0' "${f}" >/dev/null 2>&1 && n=$((n + 1))
  done
  echo "${n}"
}

# One line per task under one seed's replay root whose episode wrote no plan event: "registered
# <seed>/<task>" when the key is in the arm's planner.live_plan_keys (comma-joined in $3; LP prereg
# Amendment 4: the ceiling ended before its planner wrote a plan, so that key alone gets a live first
# plan), else "unregistered <seed>/<task>". Same per-file jq verdict as lp_plan_count.
lp_plan_gaps () {
  local root="$1" seed="$2" keys="$3" f t
  for f in "${root}"/*/events.jsonl; do
    [[ -f "${f}" ]] || continue
    jq -R -n -e '[inputs | fromjson? | select(.event_type == "plan")] | length > 0' "${f}" >/dev/null 2>&1 && continue
    t="$(basename "$(dirname "${f}")")"
    if [[ ",${keys}," == *",${seed}/${t},"* ]]; then
      echo "registered ${seed}/${t}"
    else
      echo "unregistered ${seed}/${t}"
    fi
  done
}

# ---- prefix arms: the replayed trajectory's campaign must be complete --------------------------
# A prefix arm re-executes the first m actions of handoff.source_campaign (its LP ceiling).
# Against a partial source a replay episode either finds no events.jsonl -- effective_m=0, a
# handoff that silently never happened -- or replays an episode that crashed, which the ceiling's
# next resubmission purges and re-plans, leaving this arm paired with a trajectory nobody scored.
# So every selected prefix_handoff arm's source must exist and hold, for EACH seed in SEEDS,
# >= N_FULL_TASKS result.json whose error_type is not "crash", with 0 crashed and 0 unreadable.
# Counted per seed: 114 seed-1 rows would pass a pooled >= 114 with seed 2 absent. Ported from
# hj12_require_complete_sources in scripts/pbs/hj12_prefix.pbs (itself require_complete_source in
# scripts/pbs/j10_arm.pbs), copied rather than sourced: sourcing either would run its job. The
# full count applies under SMOKE_ONLY=1 too -- a smoke that passes on a partial source is a gate
# passing for the wrong reason. Reads SELECTED; returns 2 after one FATAL line per failing arm.
lp_require_complete_sources () {
  local -a specs=()
  local spec system cfg stem rc
  for spec in "${SELECTED[@]}"; do
    IFS='|' read -r system cfg stem <<< "${spec}"
    [[ "${system}" == "prefix_handoff" ]] && specs+=("${stem}|${cfg}")
  done
  if [[ "${#specs[@]}" -eq 0 ]]; then
    echo "[lp] replay sources: no selected prefix_handoff arm; nothing to check"
    return 0
  fi
  echo "[lp] ---- replay sources (${#specs[@]} prefix_handoff arms; need >= ${N_FULL_TASKS} non-crashed per seed, SEEDS=${SEEDS}) ----"
  timeout 600 "${PY}" - "${SEEDS}" "${N_FULL_TASKS}" "${specs[@]}" <<'PY'
import json
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    print("[lp] FATAL: PyYAML missing; cannot read handoff.source_campaign; no server started")
    sys.exit(2)

seeds = [s.strip() for s in sys.argv[1].split(",") if s.strip()]
need = int(sys.argv[2])
if not seeds:
    print(f"[lp] FATAL: SEEDS={sys.argv[1]!r} names no seed; cannot judge the replay sources")
    sys.exit(2)


def inspect(src):
    root = Path(src)
    ok = {s: 0 for s in seeds}
    crash = bad = 0
    if root.is_dir():
        for path in root.rglob("result.json"):
            try:
                row = json.loads(path.read_text(encoding="utf-8").strip() or "null")
            except (OSError, UnicodeDecodeError, json.JSONDecodeError):
                bad += 1
                continue
            if not isinstance(row, dict):
                bad += 1
            elif row.get("error_type") == "crash":
                crash += 1
            elif str(row.get("seed")) in ok:
                ok[str(row.get("seed"))] += 1
    return root.is_dir(), ok, crash, bad


seen = {}
failed = 0
for arg in sys.argv[3:]:
    stem, cfg = arg.split("|", 1)
    try:
        data = yaml.safe_load(Path(cfg).read_text(encoding="utf-8")) or {}
    except (OSError, yaml.YAMLError) as exc:
        print(f"[lp] FATAL: arm {stem} config {cfg} is unreadable ({exc}); no server started")
        failed = 1
        continue
    handoff = data.get("handoff") if isinstance(data, dict) else None
    src = handoff.get("source_campaign") if isinstance(handoff, dict) else None
    src = str(src).strip() if src else ""
    if not src:
        print(f"[lp] FATAL: arm {stem} config {cfg} has no handoff.source_campaign; no server started")
        failed = 1
        continue
    if src not in seen:
        seen[src] = inspect(src)
    exists, ok, crash, bad = seen[src]
    counts = (
        f"exists={int(exists)} non_crashed="
        + ",".join(f"seed{s}:{n}" for s, n in ok.items())
        + f" crashed={crash} unreadable={bad}"
    )
    if exists and crash == 0 and bad == 0 and all(n >= need for n in ok.values()):
        print(f"[lp] replay source ok: arm {stem} source {src} {counts}")
        continue
    print(
        f"[lp] FATAL: arm {stem} replay source {src} is not complete: {counts} "
        f"(need >= {need} non-crashed per seed for SEEDS={','.join(seeds)}, 0 crashed, "
        "0 unreadable); no server started"
    )
    failed = 1
sys.exit(2 if failed else 0)
PY
  rc=$?
  if [[ "${rc}" -ne 0 && "${rc}" -ne 2 ]]; then
    echo "[lp] FATAL: could not inspect the replay sources (rc=${rc}); no server started"
  fi
  [[ "${rc}" -eq 0 ]] || return 2
}

# ---- the campaign_summarize --gate flags per system --------------------------------------------
# Live arms: --expect-planner --expect-model -- every live arm calls the planner, and every
# recorded planner model id must be the served one.
# Prefix arms: NOT --expect-planner. Most prefix episodes make zero live planner calls, and under
# --expect-planner the model check also demands a recorded model id, which a healthy arm with no
# answered ask does not have (hj12_prefix.pbs run_arm: it "would fail a healthy arm"). Nor the
# bare --gate hj12_prefix.pbs uses: without --expect-planner, campaign_summarize.gate requires
# ZERO live planner calls and fails the arm otherwise -- right for a free arm, wrong here, where an
# answered ask is part of the system (several published luna prefix arms failed exactly that
# check, e.g. hj13_prefix_hf_m6_20260923 with 10 live calls, job 25699981). A prefix smoke gate
# that failed on one answered ask would stop the arm before its full run -- selection on outcome.
# --allow-live-planner drops the zero requirement and keeps
# --expect-model over the planner usage records that exist: vacuous at zero live calls, and a
# wrong server or a mock fallback fails the arm as soon as one ask is answered.
lp_gate_flags () {
  local system="$1"
  if [[ "${system}" == "prefix_handoff" ]]; then
    GATE_FLAGS=(--gate --allow-live-planner --expect-model "${PLANNER_MODEL}")
  else
    GATE_FLAGS=(--gate --expect-planner --expect-model "${PLANNER_MODEL}")
  fi
}

if [[ "${SELFTEST}" == "gate_flags" ]]; then
  PLANNER_MODEL="${LP_SELFTEST_PLANNER_MODEL:?}"
  lp_gate_flags "${LP_SELFTEST_SYSTEM:?}"
  printf '%s\n' "${GATE_FLAGS[@]}"
  exit 0
fi
if [[ "${SELFTEST}" == "source_check" ]]; then
  # LP_SOURCE_SPECS ("system|config|stem" ..., space-separated) stands in for SELECTED so a test
  # can point an arm at a synthetic source; unset, the real ARMS / ARMSET selection is judged
  # against the real sources (read-only).
  if [[ -n "${LP_SOURCE_SPECS:-}" ]]; then
    read -r -a SELECTED <<< "${LP_SOURCE_SPECS}"
  else
    lp_select_arms
  fi
  lp_require_complete_sources || exit 2
  echo "[lp] selftest: source_check passed (${#SELECTED[@]} selected arms)"
  exit 0
fi
if [[ "${SELFTEST}" == "plan_count" ]]; then
  lp_plan_count "${LP_PLAN_ROOT:?}"
  exit 0
fi
if [[ "${SELFTEST}" == "plan_gaps" ]]; then
  lp_plan_gaps "${LP_PLAN_ROOT:?}" "${LP_SELFTEST_SEED:?}" "${LP_SELFTEST_LIVE_KEYS:-}"
  exit 0
fi
if [[ "${SELFTEST}" == "resume_purge" ]]; then
  # The resume path on a constructed tree, through the helpers the resume scan and lp_run_arm
  # call: completeness before the purge (the scan's view), the crash-only purge, the recount.
  # Needs <LP_SELFTEST_OUT>/results/<cid>/manifest.json for "complete" to be reachable at all.
  OUT="${LP_SELFTEST_OUT:?}"
  N_PLANNED="${LP_SELFTEST_N_PLANNED:?}"
  _cid="${LP_SELFTEST_CID:?}"; _before=0; _after=0
  lp_arm_complete "${_cid}" && _before=1
  lp_purge_crashed "${_cid}"
  read -r _n _nc <<< "$(lp_campaign_stats "${_cid}" || true)"
  lp_arm_complete "${_cid}" && _after=1
  echo "[lp] selftest: resume_purge cid=${_cid} complete_before=${_before} n_runs=${_n:-0} n_crashed=${_nc:-0} n_planned=${N_PLANNED} complete_after=${_after}"
  exit 0
fi
if [[ "${SELFTEST}" == "guard" ]]; then
  read -r -a _cfgs <<< "${LP_GUARD_CONFIGS:?}"
  lp_planner_guard "${_cfgs[@]}"
  exit $?
fi
if [[ "${SELFTEST}" == "select" ]]; then
  lp_select_arms
  printf '%s\n' "${SELECTED[@]}"
  exit 0
fi

JOB_CID="lp_live_${ARMSET:-arms}_$(date -u +%Y%m%d)"
mkdir -p "${PBS_LOGDIR}"
exec >> "${PBS_LOGDIR}/${JOB_CID}.${JOBTAG}.out" 2>&1
echo "[lp] job=${JOBTAG} armset=${ARMSET} arms=${ARMS} seeds=${SEEDS} smoke_only=${SMOKE_ONLY} host=$(hostname)"

cd "${REPO}" || exit 1
export PYTHONPATH="${REPO}/src:${REPO}:${PYTHONPATH:-}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
# The runner and the executor server read granite (and its tokenizer) from here; the planner
# server gets its own HF_HOME at launch.
export HF_HOME="${GRANITE_HF_HOME}"
# AppWorld otherwise falls back to <cwd>/data/tasks, which does not exist in the worktree
# (LP-1 resubmission 25724293 died in the smoke on exactly that).
export APPWORLD_ROOT=/scratch/n12194778/sidekick/appworld
export PATH="${SIDEKICK_VENV}/bin:${HOME}/.local/bin:${PATH}"
export SIDEKICK_START_COMMIT="$(git -C "${REPO}" rev-parse HEAD 2>/dev/null || echo unknown)"
# vLLM's JIT kernels need nvcc; the one that works is bundled in the venv's cu13 wheel (LP-1's
# first submission 25724202 died after 1m53s without it).
CU13="${SIDEKICK_VENV}/lib/python3.12/site-packages/nvidia/cu13"
if [[ -x "${CU13}/bin/nvcc" ]]; then
  export CUDA_HOME="${CU13}"; export CUDA_PATH="${CU13}"
  export PATH="${CU13}/bin:${PATH}"
  export LD_LIBRARY_PATH="${CU13}/lib:${CU13}/lib64:${LD_LIBRARY_PATH:-}"
else
  echo "[lp] FATAL: no nvcc at ${CU13}/bin/nvcc; vLLM's JIT kernels cannot build"; exit 2
fi
export VLLM_USE_FLASHINFER_SAMPLER=0
# DeepGEMM off, for both servers. The LP-2 ceiling's planner (25724310, Qwen3.8-27B-FP8) died
# in the profiling dummy run inside DeepGEMM's FP8 GEMM JIT: `RuntimeError: Assertion error
# (.../deepgemm-src/.../jit/compiler.hpp:234): false and "NVCC compilation failed"`
# (campaign/workers/logs/lp2_planner_alone_cap81_qwen38_27b_20260923.25724310.aqua_vllm.log:259).
# vLLM 0.29 reads the switch at vllm/envs.py:1541; at 0, is_deep_gemm_supported() is False
# (vllm/utils/deep_gemm.py:110). Inert for the bf16 servers (granite, Qwen3-8B).
export VLLM_USE_DEEP_GEMM=0
export FLASHINFER_CACHE_DIR=/scratch/n12194778/sidekick/logs/flashinfer_cache_u9
export TORCHINDUCTOR_CACHE_DIR=/scratch/n12194778/sidekick/cache/inductor
export TRITON_CACHE_DIR=/scratch/n12194778/sidekick/cache/triton
mkdir -p "${LOGDIR}" "${OUT}/results" "${FLASHINFER_CACHE_DIR}" "${TORCHINDUCTOR_CACHE_DIR}" "${TRITON_CACHE_DIR}"
ulimit -n 65536 2>/dev/null || ulimit -n 16384 2>/dev/null || true

# ---- arms and the planner guard: all before any GPU is touched ------------------------------
lp_select_arms
declare -A ARM_CID ARM_SRC ARM_PSYS ARM_K ARM_LIVEKEYS ARM_SYS
cfgs=()
for spec in "${SELECTED[@]}"; do
  IFS='|' read -r _sys cfg _stem <<< "${spec}"
  if [[ ! -f "${cfg}" ]]; then
    echo "[lp] FATAL: config absent: ${cfg} (run scripts/setup/make_lp_configs.py)"; exit 2
  fi
  cfgs+=("${cfg}")
  ARM_SYS["${cfg}"]="${_sys}"
done
GUARD_OUT="$(lp_planner_guard "${cfgs[@]}")"
GUARD_RC=$?
grep -v '^ARM|\|^PLANNER_MODEL|' <<< "${GUARD_OUT}"
if [[ "${GUARD_RC}" -ne 0 ]]; then
  echo "[lp] FATAL: planner guard refused (rc=${GUARD_RC}); no server started"; exit 2
fi
while IFS='|' read -r _tag cfg cid src psys k lkeys; do
  ARM_CID["${cfg}"]="${cid}"; ARM_SRC["${cfg}"]="${src}"; ARM_PSYS["${cfg}"]="${psys}"; ARM_K["${cfg}"]="${k}"
  ARM_LIVEKEYS["${cfg}"]="${lkeys}"
done < <(grep '^ARM|' <<< "${GUARD_OUT}")
PLANNER_MODEL="$(grep '^PLANNER_MODEL|' <<< "${GUARD_OUT}" | cut -d'|' -f2)"
if [[ -z "${PLANNER_MODEL}" ]]; then
  echo "[lp] FATAL: guard named no planner model"; exit 2
fi
echo "[lp] planner model (from the configs, not a job variable): ${PLANNER_MODEL}"

echo "[lp] ---- scripts/setup/verify_configs.py ----"
timeout 300 "${PY}" "${REPO}/scripts/setup/verify_configs.py" > "${LOGDIR}/${JOB_CID}.${JOBTAG}_verify.log" 2>&1
VERIFY_RC=$?
tail -n 5 "${LOGDIR}/${JOB_CID}.${JOBTAG}_verify.log"
if [[ "${VERIFY_RC}" -ne 0 ]]; then
  echo "[lp] FATAL: verify_configs.py exited ${VERIFY_RC}; no server started"; exit 2
fi

# Prefix arms: the replayed LP ceiling must be complete (lp_require_complete_sources, above).
if ! lp_require_complete_sources; then
  echo "[lp] FATAL: a prefix arm's replay source is incomplete; no server started"; exit 2
fi

# The replayed first plans (lp_plan_count, defined above the self-tests).
IFS=, read -r -a SEED_LIST <<< "${SEEDS}"
for cfg in "${cfgs[@]}"; do
  src="${ARM_SRC[${cfg}]}"
  if [[ -z "${src}" ]]; then
    echo "[lp] FATAL: $(basename "${cfg}") has no planner.packet_source; the LP arms replay the ceiling's first plan"; exit 2
  fi
  if [[ "${ARM_SYS[${cfg}]}" == "prefix_handoff" ]]; then
    # A prefix arm never calls plan(): it takes the plan from the replayed prefix
    # (src/sidekick/systems/loop.py:697), whose source lp_require_complete_sources has checked.
    # A source episode that wrote no plan replays as no plan (LP prereg Amendment 4).
    echo "[lp] $(basename "${cfg}"): prefix arm; its plan comes from the replayed prefix, not the packet cache"
    continue
  fi
  for seed in "${SEED_LIST[@]}"; do
    n_plans="$(lp_plan_count "${src}/${ARM_PSYS[${cfg}]}/${seed}")"
    echo "[lp] replay source $(basename "${src}") seed ${seed}: ${n_plans}/${N_FULL_TASKS} tasks carry a plan event"
    if [[ "${n_plans}" -lt "${N_FULL_TASKS}" ]]; then
      gaps="$(lp_plan_gaps "${src}/${ARM_PSYS[${cfg}]}/${seed}" "${seed}" "${ARM_LIVEKEYS[${cfg}]}")"
      reg="$(grep '^registered ' <<< "${gaps}" | cut -d' ' -f2 | tr '\n' ' ')"
      unreg="$(grep '^unregistered ' <<< "${gaps}" | cut -d' ' -f2 | tr '\n' ' ')"
      n_reg="$(grep -c '^registered ' <<< "${gaps}")"
      if [[ -z "${unreg// /}" && $((n_plans + n_reg)) -ge "${N_FULL_TASKS}" ]]; then
        echo "[lp] replay source seed ${seed}: ${n_reg} key(s) without a plan are registered in planner.live_plan_keys and get a live first plan (LP prereg Amendment 4): ${reg}"
      elif [[ "${SMOKE_ONLY}" == "1" ]]; then
        echo "[lp] WARN: incomplete replay source; SMOKE_ONLY=1 continues, a smoke task without a plan will abort"
      else
        echo "[lp] FATAL: replay source incomplete (keys without a plan and not in planner.live_plan_keys: ${unreg:-none, but task directories are missing}); wait for the ceiling run to finish"; exit 2
      fi
    fi
  done
done

# ---- resume scan (lp_arm_complete: crash-only, see "resume bookkeeping" above) ----------------
PENDING=()
for spec in "${SELECTED[@]}"; do
  IFS='|' read -r _sys cfg stem <<< "${spec}"
  if lp_arm_complete "${ARM_CID[${cfg}]}"; then
    echo "[lp] resume: ${ARM_CID[${cfg}]} complete; skipped"
  else
    PENDING+=("${spec}")
  fi
done
if [[ "${#PENDING[@]}" -eq 0 ]]; then
  echo "[lp] every selected arm is complete; no server started"; exit 0
fi

# ---- placement ------------------------------------------------------------------------------
if [[ -n "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  IFS=, read -r -a GPU_LIST <<< "${CUDA_VISIBLE_DEVICES}"
else
  mapfile -t GPU_LIST < <(nvidia-smi --query-gpu=index --format=csv,noheader 2>/dev/null | tr -d ' ')
fi
NGPU="${NGPU:-${#GPU_LIST[@]}}"
if [[ "${NGPU}" -ne "${#GPU_LIST[@]}" || "${NGPU}" -lt 1 ]]; then
  echo "[lp] FATAL: NGPU=${NGPU} but ${#GPU_LIST[@]} GPU(s) visible (${GPU_LIST[*]:-none}); the select line and NGPU disagree"; exit 2
fi
if [[ "${NGPU}" -ge 2 ]]; then PLACEMENT="${PLACEMENT:-split}"; else PLACEMENT="${PLACEMENT:-shared}"; fi
case "${PLACEMENT}" in
  shared)
    EXECUTOR_DEV="${GPU_LIST[0]}"; PLANNER_DEV="${GPU_LIST[0]}"
    EXECUTOR_GPU_UTIL="${EXECUTOR_GPU_UTIL:-0.40}"; PLANNER_GPU_UTIL="${PLANNER_GPU_UTIL:-0.40}"
    if ! awk -v a="${EXECUTOR_GPU_UTIL}" -v b="${PLANNER_GPU_UTIL}" 'BEGIN { exit !(a + b <= 0.90) }'; then
      echo "[lp] FATAL: shared card over-committed: ${EXECUTOR_GPU_UTIL} + ${PLANNER_GPU_UTIL} > 0.90"; exit 2
    fi
    case "${PLANNER_MODEL}" in
      *27B*|*32B*|*70B*)
        echo "[lp] FATAL: ${PLANNER_MODEL} does not fit beside granite on one card; submit with ngpus=2 (see header)"; exit 2;;
    esac
    ;;
  split)
    if [[ "${NGPU}" -lt 2 ]]; then echo "[lp] FATAL: PLACEMENT=split needs ngpus>=2"; exit 2; fi
    EXECUTOR_DEV="${GPU_LIST[0]}"; PLANNER_DEV="${GPU_LIST[1]}"
    EXECUTOR_GPU_UTIL="${EXECUTOR_GPU_UTIL:-0.85}"; PLANNER_GPU_UTIL="${PLANNER_GPU_UTIL:-0.85}"
    ;;
  *) echo "[lp] FATAL: PLACEMENT must be shared|split, got ${PLACEMENT}"; exit 2;;
esac
echo "[lp] placement=${PLACEMENT} executor@${EXECUTOR_DEV} util=${EXECUTOR_GPU_UTIL} planner@${PLANNER_DEV} util=${PLANNER_GPU_UTIL}"

case "${PLANNER_MODEL}" in
  Qwen/Qwen3-8B) _hf_default="${HOME}/.cache/huggingface";;
  Qwen/Qwen3.8-27B-FP8) _hf_default=/mnt/hpccs01/home/n12194778/.cache/hf_planners;;
  *) _hf_default="";;
esac
PLANNER_HF_HOME="${PLANNER_HF_HOME:-${_hf_default}}"
_hub_dir="${PLANNER_HF_HOME}/hub/models--${PLANNER_MODEL//\//--}"
if [[ -z "${PLANNER_HF_HOME}" || ! -d "${_hub_dir}" ]]; then
  echo "[lp] FATAL: no cached ${PLANNER_MODEL} under PLANNER_HF_HOME='${PLANNER_HF_HOME}' (${_hub_dir}); set PLANNER_HF_HOME"; exit 2
fi
if [[ ! -f "${ADAPTER_SFT_B_PLUS}/adapter_config.json" ]] || \
   [[ ! -f "${ADAPTER_SFT_B_PLUS}/adapter_model.safetensors" && ! -f "${ADAPTER_SFT_B_PLUS}/adapter_model.bin" && ! -f "${ADAPTER_SFT_B_PLUS}/adapter_model.pt" ]]; then
  # A trainer output dir exists from step 0 with only trainer_state/; "is a directory" is not loadable.
  echo "[lp] FATAL: ${ADAPTER_SFT_B_PLUS} is not a loadable PEFT adapter (adapter_config.json + weights)"; exit 2
fi

# ---- servers ------------------------------------------------------------------------------
EXEC_PID=""; PLANNER_PID=""
lp_kill_group () {
  local pid="$1" _
  [[ -n "${pid}" ]] || return 0
  kill -TERM -- -"${pid}" 2>/dev/null || true
  for _ in $(seq 1 12); do kill -0 "${pid}" 2>/dev/null || break; sleep 5; done
  kill -KILL -- -"${pid}" 2>/dev/null || true
  wait "${pid}" 2>/dev/null || true
}
lp_cleanup () {
  lp_kill_group "${PLANNER_PID}"; PLANNER_PID=""
  lp_kill_group "${EXEC_PID}"; EXEC_PID=""
  echo "[lp] GPU after shutdown:"
  nvidia-smi --query-gpu=index,memory.used --format=csv,noheader 2>/dev/null || true
}
trap lp_cleanup EXIT
# qdel and walltime send TERM; without this trap bash dies without running the EXIT trap and
# both servers (their own sessions, via setsid) would outlive the job on a shared node.
trap 'echo "[lp] caught signal; stopping both servers"; exit 143' TERM INT HUP

lp_fatal () { echo "[lp] FATAL: $*"; exit 1; }

lp_port_busy () {
  local p="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk -v want="${p}" '$1 == "LISTEN" { n = split($4, a, ":"); if (a[n] == want) f = 1 } END { exit f ? 0 : 1 }'
  else
    curl -sf "http://127.0.0.1:${p}/v1/models" >/dev/null 2>&1
  fi
}
# Runs inside $(...): complaints go to stderr, or the caller would read them as the port.
lp_pick_port () {
  local p="$1" avoid="$2" tries=0
  while [[ "${p}" == "${avoid}" ]] || lp_port_busy "${p}"; do
    tries=$((tries + 1))
    if [[ "${tries}" -ge 50 ]]; then echo "[lp] FATAL: no free port after 50 tries (last ${p})" >&2; return 1; fi
    p=$((p + 1)); [[ "${p}" -ge 40000 ]] && p=20000
  done
  echo "${p}"
}

lp_wait_healthy () {
  local label="$1" pid="$2" port="$3" log="$4" t0 deadline
  t0=$(date +%s); deadline=$((t0 + 900))
  while (( $(date +%s) < deadline )); do
    if ! kill -0 "${pid}" 2>/dev/null; then
      echo "[lp] ${label} vllm died before healthy; log tail:"; tail -n 60 "${log}"; lp_fatal "${label} server died"
    fi
    if curl -sf "http://127.0.0.1:${port}/v1/models" >/dev/null 2>&1; then
      echo "[lp] ${label} healthy on ${port} after $(( $(date +%s) - t0 ))s"; return 0
    fi
    sleep 5
  done
  tail -n 60 "${log}"; lp_fatal "${label} not healthy within 900s"
}

# Served-model identity. Every wanted id must be listed; with `exact` (the planner, which has no
# LoRA), nothing else may be -- lp1_planner_alone.pbs checks the same with .data[0].id. Then
# the listener's process group must be ours: a port that answered but belongs to another job's
# server would pass every health check while serving the wrong model.
lp_identity () {
  local label="$1" port="$2" pid="$3" mode="$4"; shift 4
  local body ids w line lpid lpgid
  body="$(curl -sf "http://127.0.0.1:${port}/v1/models")" || lp_fatal "${label}: /v1/models failed"
  ids="$(jq -r '.data[]?.id' <<< "${body}" 2>/dev/null)" || lp_fatal "${label}: /v1/models is not JSON"
  for w in "$@"; do
    grep -Fxq "${w}" <<< "${ids}" || lp_fatal "${label}: served ids [$(tr '\n' ' ' <<< "${ids}")] lack '${w}'"
  done
  if [[ "${mode}" == "exact" && "$(grep -c . <<< "${ids}")" -ne "$#" ]]; then
    lp_fatal "${label}: served ids [$(tr '\n' ' ' <<< "${ids}")], expected exactly [$*]"
  fi
  echo "[lp] ${label} serves: $(tr '\n' ' ' <<< "${ids}")"
  if command -v ss >/dev/null 2>&1; then
    line="$(ss -ltnp 2>/dev/null | awk -v p="${port}" '$1 == "LISTEN" { n = split($4, a, ":"); if (a[n] == p) { print; exit } }')"
    if [[ "${line}" =~ pid=([0-9]+) ]]; then
      lpid="${BASH_REMATCH[1]}"
      lpgid="$(ps -o pgid= -p "${lpid}" 2>/dev/null | tr -d '[:space:]')"
      [[ "${lpgid}" == "${pid}" ]] || lp_fatal "${label}: port ${port} held by pid=${lpid} pgid=${lpgid}, expected pgid=${pid}"
      echo "[lp] ${label} listener pid=${lpid} pgid matches"
    else
      echo "[lp] WARN: ${label}: no pid on the LISTEN line for ${port}; pgid check skipped"
    fi
  fi
}

_jobnum="${PBS_JOBID%%.*}"; _jobnum="${_jobnum//[^0-9]/}"; _jobnum="${_jobnum:-$$}"
EXEC_PORT="$(lp_pick_port $(( 20000 + _jobnum % 20000 )) "")" || exit 1
EXEC_VLOG="${LOGDIR}/${JOB_CID}.${JOBTAG}_executor_vllm.log"
echo "[lp] executor: ${MODEL_GRANITE} + ${ALIAS_SFT_B_PLUS}=${ADAPTER_SFT_B_PLUS} port=${EXEC_PORT} log=${EXEC_VLOG}"
CUDA_VISIBLE_DEVICES="${EXECUTOR_DEV}" HF_HOME="${GRANITE_HF_HOME}" \
setsid "${SIDEKICK_VENV}/bin/vllm" serve "${MODEL_GRANITE}" \
  --served-model-name "${MODEL_GRANITE}" \
  --dtype bfloat16 \
  --max-model-len 32768 \
  --host 127.0.0.1 --port "${EXEC_PORT}" \
  --gpu-memory-utilization "${EXECUTOR_GPU_UTIL}" \
  --enable-lora \
  --max-loras "${MAX_LORAS}" \
  --max-lora-rank 64 \
  --lora-modules "${ALIAS_SFT_B_PLUS}=${ADAPTER_SFT_B_PLUS}" \
  > "${EXEC_VLOG}" 2>&1 &
EXEC_PID=$!
lp_wait_healthy executor "${EXEC_PID}" "${EXEC_PORT}" "${EXEC_VLOG}"
lp_identity executor "${EXEC_PORT}" "${EXEC_PID}" has "${MODEL_GRANITE}" "${ALIAS_SFT_B_PLUS}"
export SIDEKICK_VLLM_BASE_URL="http://127.0.0.1:${EXEC_PORT}"

PLANNER_PORT="$(lp_pick_port $(( EXEC_PORT + 1 )) "${EXEC_PORT}")" || exit 1
PLANNER_VLOG="${LOGDIR}/${JOB_CID}.${JOBTAG}_planner_vllm.log"
echo "[lp] planner: ${PLANNER_MODEL} port=${PLANNER_PORT} HF_HOME=${PLANNER_HF_HOME} max_len=${PLANNER_MAX_LEN} log=${PLANNER_VLOG}"
# --max-num-seqs 64, as in lp1_planner_alone.pbs: the hybrid 27B's Mamba cache (706 blocks on one
# H100) cannot back vLLM's default 1024 sequences; 64 is far above WORKERS and changes no output.
CUDA_VISIBLE_DEVICES="${PLANNER_DEV}" HF_HOME="${PLANNER_HF_HOME}" HF_HUB_OFFLINE=1 \
setsid "${SIDEKICK_VENV}/bin/vllm" serve "${PLANNER_MODEL}" \
  --served-model-name "${PLANNER_MODEL}" \
  --dtype bfloat16 \
  --max-model-len "${PLANNER_MAX_LEN}" \
  --max-num-seqs 64 \
  --host 127.0.0.1 --port "${PLANNER_PORT}" \
  --gpu-memory-utilization "${PLANNER_GPU_UTIL}" \
  > "${PLANNER_VLOG}" 2>&1 &
PLANNER_PID=$!
lp_wait_healthy planner "${PLANNER_PID}" "${PLANNER_PORT}" "${PLANNER_VLOG}"
lp_identity planner "${PLANNER_PORT}" "${PLANNER_PID}" exact "${PLANNER_MODEL}"
export SIDEKICK_PLANNER_BASE_URL="http://127.0.0.1:${PLANNER_PORT}/v1"
echo "[lp] SIDEKICK_VLLM_BASE_URL=${SIDEKICK_VLLM_BASE_URL} SIDEKICK_PLANNER_BASE_URL=${SIDEKICK_PLANNER_BASE_URL}"
nvidia-smi --query-gpu=index,memory.used,memory.total --format=csv,noheader 2>/dev/null || true

# ---- per arm: smoke -> error_type check -> gate -> full -> tally -----------------------------
# The exit code proves nothing -- job 25713123 exited 0 with 47/57 episodes crashed -- so every
# phase reads result.json. A crash is error_type == "crash" (or an unreadable result.json) and
# nothing else; limit/timeout/parse_error/api_error are scored outcomes, shown in the
# distribution but never refilled.
lp_tally () {
  local cid="$1" types stats
  types="$(find "${OUT}/${cid}" -name result.json -print0 2>/dev/null | xargs -0 -r jq -r '.error_type // "none"' 2>/dev/null)"
  stats="$(lp_campaign_stats "${cid}" || true)"
  read -r TALLY_N TALLY_CRASH <<< "${stats:-0 0}"
  TALLY_N="${TALLY_N:-0}"; TALLY_CRASH="${TALLY_CRASH:-0}"
  echo "[lp] ${cid}: result.json=${TALLY_N} crashed=${TALLY_CRASH} (crash or unreadable); error_type distribution:"
  [[ -n "${types}" ]] && sort <<< "${types}" | uniq -c | sort -rn
}
# Events carry the error as `error_type` (loop.emit(error=...) -> Event.error_type); matching
# `.error` printed nothing, so a crash FATAL came with no payloads.
lp_crash_details () {
  find "${OUT}/$1" -name events.jsonl -print0 2>/dev/null | xargs -0 -r cat 2>/dev/null \
    | jq -R -c 'fromjson? | select(.error_type == "crash") | .payload' 2>/dev/null | head -n 5
}
# A takeover arm that authored no action ran the advise path. Only damning when some smoke
# episode got far enough (steps >= k) for a review to have fired.
lp_takeover_check () {
  local stem="$1" scid="$2" k="$3" n_act max_steps
  n_act="$(find "${OUT}/${scid}" -name events.jsonl -print0 2>/dev/null | xargs -0 -r cat 2>/dev/null \
    | jq -R -c 'fromjson? | select(.event_type == "action" and .actor == "planner")' 2>/dev/null | wc -l)"
  if [[ "${n_act}" -gt 0 ]]; then echo "[lp] ${stem}: ${n_act} planner-authored actions on smoke"; return 0; fi
  max_steps="$(find "${OUT}/${scid}" -name result.json -print0 2>/dev/null | xargs -0 -r jq -r '.steps // 0' 2>/dev/null | sort -n | tail -n 1)"
  if [[ -n "${k}" && "${max_steps:-0}" -ge "${k}" ]]; then
    echo "[lp] FATAL: takeover arm ${stem} authored 0 planner actions although an episode reached step ${max_steps} >= k=${k}; it ran the advise path"
    return 1
  fi
  echo "[lp] WARN: ${stem}: 0 planner actions on smoke, but no episode reached k=${k}; smoke uninformative"
}

lp_run_arm () {
  local system="$1" cfg="$2" stem="$3"
  local cid="${ARM_CID[${cfg}]}" scid="${ARM_CID[${cfg}]}_smoke"
  local n_runs rc camp_rc sum_rc
  local -a gate
  lp_gate_flags "${system}"  # per system: see lp_gate_flags for why prefix arms differ
  gate=("${GATE_FLAGS[@]}")
  echo "[lp] ---- arm ${stem} cid=${cid} system=${system} ----"
  if [[ "${SMOKE_ONLY}" != "1" ]]; then
    lp_purge_crashed "${cid}"
  fi
  n_runs="$(lp_n_runs "${cid}")"
  if [[ "${n_runs}" -eq 0 ]]; then
    rm -rf "${OUT:?}/${scid:?}"
    echo "[lp] smoke: ${N_SMOKE_TASKS} tasks, seed ${SMOKE_SEED} (the full run's first seed, so no orphans)"
    timeout "${SMOKE_TIMEOUT}" "${PY}" -m sidekick.runner \
      --system "${system}" --split dev --tasks "${N_SMOKE_TASKS}" --seeds "${SMOKE_SEED}" \
      --env appworld --workers 3 --config "${cfg}" --campaign-id "${scid}" --out "${OUT}"
    rc=$?
    lp_tally "${scid}"
    if [[ "${rc}" -ne 0 ]]; then echo "[lp] FATAL: smoke runner rc=${rc} (${stem})"; return "${rc}"; fi
    if [[ "${TALLY_N}" -ne "${N_SMOKE_TASKS}" || "${TALLY_CRASH}" -ne 0 ]]; then
      echo "[lp] FATAL: smoke wrote ${TALLY_N}/${N_SMOKE_TASKS} results with ${TALLY_CRASH} crash(es); first crash payloads:"
      lp_crash_details "${scid}"
      return 1
    fi
    timeout 300 "${PY}" "${SUM}" --out "${OUT}" --campaign-id "${scid}" --config "${cfg}" --repo "${REPO}" "${gate[@]}"
    rc=$?
    if [[ "${rc}" -ne 0 ]]; then echo "[lp] FATAL: smoke gate rc=${rc} (${stem})"; return "${rc}"; fi
    # Not for a prefix arm: it has no takeover channel, whatever its stem.
    if [[ "${system}" != "prefix_handoff" && "${stem}" == *takeover* ]]; then
      lp_takeover_check "${stem}" "${scid}" "${ARM_K[${cfg}]}" || return 1
    fi
    [[ "${SMOKE_ONLY}" == "1" ]] || rm -rf "${OUT:?}/${scid:?}"
  else
    echo "[lp] resume: ${cid} has ${n_runs} result.json; smoke skipped"
  fi
  if [[ "${SMOKE_ONLY}" == "1" ]]; then echo "[lp] SMOKE_ONLY=1: ${stem} stops before the full run"; return 0; fi

  echo "[lp] full: ${N_FULL_TASKS} tasks x seeds ${SEEDS} (${N_PLANNED} episodes), workers ${WORKERS}"
  timeout "${FULL_TIMEOUT}" "${PY}" -m sidekick.runner \
    --system "${system}" --split dev --tasks "${N_FULL_TASKS}" --seeds "${SEEDS}" \
    --env appworld --workers "${WORKERS}" --config "${cfg}" --campaign-id "${cid}" --out "${OUT}"
  camp_rc=$?
  timeout 300 "${PY}" "${SUM}" --out "${OUT}" --campaign-id "${cid}" --config "${cfg}" \
    --manifest "${OUT}/results/${cid}/manifest.json" --repo "${REPO}" "${gate[@]}"
  sum_rc=$?
  lp_tally "${cid}"
  echo "[lp] ${stem} runner rc=${camp_rc} gate rc=${sum_rc}"
  [[ "${camp_rc}" -ne 0 ]] && return "${camp_rc}"
  [[ "${sum_rc}" -ne 0 ]] && return "${sum_rc}"
  if [[ "${TALLY_CRASH}" -ne 0 || "${TALLY_N}" -lt "${N_PLANNED}" ]]; then
    echo "[lp] ${stem}: ${TALLY_CRASH} crash(es), ${TALLY_N}/${N_PLANNED} episodes -- resubmit to purge and fill"
    lp_crash_details "${cid}"
    return 3
  fi
  return 0
}

job_rc=0
for spec in "${PENDING[@]}"; do
  IFS='|' read -r system cfg stem <<< "${spec}"
  lp_run_arm "${system}" "${cfg}" "${stem}"
  arm_rc=$?
  echo "[lp] arm ${stem} rc=${arm_rc}"
  if [[ "${arm_rc}" -ne 0 && "${job_rc}" -eq 0 ]]; then job_rc="${arm_rc}"; fi
  # A server that died mid-arm makes every later arm crash; stop rather than burn the rest.
  kill -0 "${EXEC_PID}" 2>/dev/null || lp_fatal "executor server gone after ${stem}"
  kill -0 "${PLANNER_PID}" 2>/dev/null || lp_fatal "planner server gone after ${stem}"
done
echo "[lp] done=$(date -Iseconds) job_rc=${job_rc} arms=${#PENDING[@]}"
exit "${job_rc}"

__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
campaign/workers/logs/

# Built SFT datasets: 8.9MB and regenerable from the archived events via
# sidekick.training.sft_data; the manifest (sha256 + task ids) IS committed.
data/interim/*.jsonl

# AppWorld protected data: redistributable only in encrypted form. Keep it outside the repo (APPWORLD_ROOT).
data/tasks/
data/api_docs/
data/base_dbs/
data/datasets/
# AppWorld writes experiment outputs relative to its root or the working directory.
experiments/
# A literal "~" directory created by an unexpanded tilde.
/~/
# Git bundles and run logs.
*.bundle
*.log
